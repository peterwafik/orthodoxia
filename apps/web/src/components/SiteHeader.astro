---
import CopticCross from './CopticCross.astro';
import { explorerPath, localePath, otherLocale, t, type Locale } from '../i18n/index.ts';

interface Props {
  locale: Locale;
  /** The current page in the other language. */
  alternate: string;
}

const { locale, alternate } = Astro.props;
const strings = t(locale);
const other = otherLocale(locale);
const current = Astro.url.pathname;
const links = [
  { href: localePath(locale, 'bible'), label: strings.nav.bible },
  { href: explorerPath(locale), label: strings.nav.explore },
  { href: localePath(locale, 'about'), label: strings.nav.about },
  { href: localePath(locale, 'sources'), label: strings.nav.sources },
];
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={localePath(locale)}>
      <CopticCross />
      <span>{strings.meta.siteName}</span>
    </a>
    <nav aria-label={strings.a11y.primaryNav}>
      <ul>
        {
          links.map(({ href, label }) => (
            <li>
              <a href={href} aria-current={current.startsWith(href) ? 'page' : undefined}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="tools">
      <a class="lang" href={alternate} hreflang={other} lang={other}>
        {strings.nav.otherLanguage}
      </a>
      <button class="theme" type="button" aria-label={strings.a11y.themeToggle} data-theme-toggle>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
          <path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  button?.addEventListener('click', () => {
    const root = document.documentElement;
    const current = root.dataset['theme'] ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset['theme'] = next;
    try {
      localStorage.setItem('orthodoxia:theme', next);
    } catch {
      // Storage unavailable: the choice lasts for this page view only.
    }
  });
</script>

<style>
  .site-header {
    border-block-end: 1px solid var(--line);
    background: var(--surface);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.5rem;
    padding-block: 0.75rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-reading);
    font-size: var(--step-1);
    font-weight: 600;
    min-block-size: 44px;
  }

  nav {
    order: 3;
    flex-basis: 100%;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    color: var(--ink-muted);
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.4em;
  }

  .tools {
    margin-inline-start: auto;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .lang {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    padding-inline: 0.5rem;
  }

  .theme {
    display: inline-grid;
    place-items: center;
    inline-size: 44px;
    block-size: 44px;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--ink);
    cursor: pointer;
  }

  .theme:hover {
    background: var(--line);
  }

  @media (min-width: 52rem) {
    nav {
      order: 0;
      flex-basis: auto;
    }
  }
</style>
