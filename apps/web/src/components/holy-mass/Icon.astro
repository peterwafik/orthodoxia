---
/**
 * The small line icons of the Holy Mass panel: the five layers and the two header buttons.
 * They are decorative: every button that uses one carries its own text label.
 */
interface Props {
  name: 'steps' | 'priest' | 'deacon' | 'people' | 'meaning' | 'stops' | 'options' | 'menu';
  size?: number;
}
const { name, size = 22 } = Astro.props;
---

<svg viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'steps' && <path d="M3 20h5v-5h5v-5h5V5h3" />}
  {
    name === 'priest' && (
      <>
        <path d="M12 3v18" />
        <path d="M6 9h12" />
        <path d="M9.5 3h5M9.5 21h5M6 6.5v5M18 6.5v5" />
      </>
    )
  }
  {
    name === 'deacon' && (
      <>
        <path d="M12 2.5v4" />
        <path d="M12 6.5 8.5 11M12 6.5 15.5 11" />
        <path d="M5 11h14a7 7 0 0 1-14 0z" />
        <path d="M12 21.5v-.5" />
      </>
    )
  }
  {
    name === 'people' && (
      <>
        <circle cx="12" cy="7.5" r="2.7" />
        <circle cx="5" cy="10" r="2.1" />
        <circle cx="19" cy="10" r="2.1" />
        <path d="M7.5 20v-2.5a4.5 4.5 0 0 1 9 0V20" />
        <path d="M1.8 19v-1.5a3.2 3.2 0 0 1 3.7-3.1M22.2 19v-1.5a3.2 3.2 0 0 0-3.7-3.1" />
      </>
    )
  }
  {
    name === 'meaning' && (
      <>
        <path d="M9 18h6M10 21h4" />
        <path d="M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2.1h5c0-.9.4-1.6 1-2.1A6 6 0 0 0 12 3z" />
      </>
    )
  }
  {
    name === 'stops' && (
      <>
        <path d="M9 6h11M9 12h11M9 18h11" />
        <path d="M4.5 6h.01M4.5 12h.01M4.5 18h.01" />
      </>
    )
  }
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {
    name === 'options' && (
      <>
        <path d="M4 7h9M17 7h3M4 17h3M11 17h9" />
        <path d="M15 4.5v5M9 14.5v5" />
      </>
    )
  }
</svg>
