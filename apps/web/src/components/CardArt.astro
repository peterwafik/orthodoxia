---
/**
 * The small line drawing at the top of each home-page card: one per card, in the same thin accent-coloured line as
 * the drawing beside the headline. Decorative only (the card's title is its label).
 */
type Name = 'bible' | 'explore' | 'threads' | 'holyMass' | 'churchHistory' | 'about';
interface Props {
  name: Name;
}
const { name } = Astro.props;

// Arcs between points on a baseline (cross-references).
const arc = (from: number, to: number, base: number, k = 0.9) => {
  const r = (to - from) / 2;
  return `M${from} ${base} A${r} ${r * k} 0 0 1 ${to} ${base}`;
};
const arcs = [
  arc(30, 90, 62),
  arc(50, 150, 62),
  arc(70, 120, 62),
  arc(100, 172, 62),
  arc(120, 160, 62),
  arc(40, 170, 62, 0.75),
];
// Rows of text on the left that thread out to the right (read with threads).
const rows = [18, 28, 38, 48, 58];
const threadTargets = [20, 34, 24, 52, 44];
---

<svg class="art" viewBox="0 0 200 80" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {
    name === 'bible' && (
      <>
        <path d="M100 30 C88 22 62 20 40 26 V62 C62 56 88 58 100 68 Z" stroke-width="1.5" />
        <path d="M100 30 C112 22 138 20 160 26 V62 C138 56 112 58 100 68 Z" stroke-width="1.5" />
        <path d="M32 30 V68 C58 62 86 64 100 74 C114 64 142 62 168 68 V30" stroke-width="1.2" opacity="0.7" />
        {[0, 1, 2, 3].map((i) => (
          <>
            <path d={`M92 ${38 + i * 6} C80 ${33 + i * 6} 64 ${33 + i * 6} 50 ${37 + i * 6}`} stroke-width="0.9" opacity="0.6" />
            <path d={`M108 ${38 + i * 6} C120 ${33 + i * 6} 136 ${33 + i * 6} 150 ${37 + i * 6}`} stroke-width="0.9" opacity="0.6" />
          </>
        ))}
        <path d="M100 8 V24 M93 14 H107" stroke-width="1.5" />
      </>
    )
  }
  {
    name === 'explore' && (
      <>
        <path d="M20 66 H180" stroke-width="1.1" opacity="0.5" />
        {arcs.map((d) => <path d={d} stroke-width="1" opacity="0.65" />)}
        <path d="M30 62 V70 M90 62 V70 M150 62 V70 M172 62 V70" stroke-width="1.4" />
      </>
    )
  }
  {
    name === 'threads' && (
      <>
        {rows.map((y) => <path d={`M20 ${y} H64`} stroke-width="1.2" opacity="0.6" />)}
        <path d="M20 38 H64" stroke-width="1.8" />
        {threadTargets.map((y, i) => (
          <path d={`M66 38 C100 38 104 ${y + 6} 150 ${y + 6}`} stroke-width={i === 2 ? 1.4 : 0.9} opacity={i === 2 ? 0.9 : 0.55} />
        ))}
        <path d="M150 14 V68 M156 14 V68" stroke-width="0" />
        {threadTargets.map((y) => <path d={`M150 ${y + 3} V${y + 9}`} stroke-width="3" opacity="0.8" />)}
      </>
    )
  }
  {
    name === 'holyMass' && (
      <>
        <path d="M100 6 V28 M91 14 H109" stroke-width="1.6" />
        <circle cx="100" cy="20" r="14" stroke-width="0.9" opacity="0.5" />
        <path d="M74 36 H126 C126 52 114 58 100 58 C86 58 74 52 74 36 Z" stroke-width="1.5" />
        <path d="M100 58 V68 M84 72 H116 M88 68 H112" stroke-width="1.5" />
        <path d="M44 74 H156" stroke-width="1.1" opacity="0.5" />
      </>
    )
  }
  {
    name === 'churchHistory' && (
      <>
        <path d="M16 48 H80" stroke-width="1.6" />
        <path d="M80 48 C100 48 104 24 124 24 H184" stroke-width="1.4" />
        <path d="M80 48 H184" stroke-width="1.4" />
        <path d="M80 48 C100 48 104 72 124 72 H184" stroke-width="1.4" />
        <circle cx="32" cy="48" r="3.2" stroke-width="1.3" />
        <circle cx="80" cy="48" r="3.8" stroke-width="1.5" />
        <circle cx="150" cy="24" r="3" stroke-width="1.2" />
        <circle cx="150" cy="48" r="3" stroke-width="1.2" />
        <circle cx="150" cy="72" r="3" stroke-width="1.2" />
        <path d="M80 36 V28 M76 32 H84" stroke-width="1.2" />
      </>
    )
  }
  {
    name === 'about' && (
      <>
        <circle cx="100" cy="40" r="26" stroke-width="1.2" />
        <circle cx="100" cy="40" r="34" stroke-width="0.9" opacity="0.5" />
        <path d="M100 22 V58 M82 40 H118" stroke-width="1.7" />
        <circle cx="100" cy="40" r="3" stroke-width="1.2" />
        {[0, 90, 180, 270].map((a) => <circle cx="100" cy="17" r="1.6" stroke-width="1" transform={`rotate(${a} 100 40)`} />)}
      </>
    )
  }
</svg>

<style>
  .art {
    display: block;
    inline-size: 100%;
    block-size: 5rem;
    margin-block-end: 0.6rem;
    color: var(--accent);
    pointer-events: none;
  }
</style>
