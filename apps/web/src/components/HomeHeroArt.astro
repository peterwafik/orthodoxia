---
/**
 * The drawing beside the headline on the home page: an open Bible with arcs of cross-references rising from it
 * around a cross, as in the cross-reference diagram. Thin lines in the theme's accent colour. Decorative only.
 */
const CENTER = 175;
const BASE = 262;

// Small arcs between points on the baseline, always the same ones (a fixed sequence, not random at build time).
let seed = 11;
const next = (): number => (seed = (seed * 16807) % 2147483647) / 2147483647;
const arcs = Array.from({ length: 18 }, () => {
  const from = 24 + Math.floor(next() * 26) * 10;
  const to = Math.min(326, from + 50 + Math.floor(next() * 18) * 10);
  const radius = (to - from) / 2;
  return `M${from} ${BASE} A${radius} ${Math.min(radius, 190) * 0.9} 0 0 1 ${to} ${BASE}`;
});
const rings = [150, 116, 82].map((r) => ({ r, d: `M${CENTER - r} ${BASE} A${r} ${r * 0.9} 0 0 1 ${CENTER + r} ${BASE}` }));

// The open book: two pages, the cover edge and the lines of text.
const Y = 222;
const W = 96;
const H = 40;
const leftPage = `M${CENTER} ${Y + 18} C${CENTER - W * 0.3} ${Y + 2} ${CENTER - W * 0.75} ${Y - 2} ${CENTER - W} ${Y + 6} V${Y + H} C${CENTER - W * 0.75} ${Y + H - 8} ${CENTER - W * 0.3} ${Y + H - 4} ${CENTER} ${Y + H + 14} Z`;
const rightPage = `M${CENTER} ${Y + 18} C${CENTER + W * 0.3} ${Y + 2} ${CENTER + W * 0.75} ${Y - 2} ${CENTER + W} ${Y + 6} V${Y + H} C${CENTER + W * 0.75} ${Y + H - 8} ${CENTER + W * 0.3} ${Y + H - 4} ${CENTER} ${Y + H + 14} Z`;
const cover = `M${CENTER - W - 8} ${Y + 12} V${Y + H + 8} C${CENTER - W * 0.75} ${Y + H + 2} ${CENTER - W * 0.3} ${Y + H + 6} ${CENTER} ${Y + H + 24} C${CENTER + W * 0.3} ${Y + H + 6} ${CENTER + W * 0.75} ${Y + H + 2} ${CENTER + W + 8} ${Y + H + 8} V${Y + 12}`;
const lines = Array.from({ length: 6 }, (_, i) => {
  const dy = 16 + i * ((H - 30) / 5);
  return [
    `M${CENTER - 12} ${Y + dy + 10} C${CENTER - W * 0.3} ${Y + dy - 2} ${CENTER - W * 0.6} ${Y + dy - 4} ${CENTER - W + 14} ${Y + dy + 4}`,
    `M${CENTER + 12} ${Y + dy + 10} C${CENTER + W * 0.3} ${Y + dy - 2} ${CENTER + W * 0.6} ${Y + dy - 4} ${CENTER + W - 14} ${Y + dy + 4}`,
  ];
}).flat();
---

<div class="hero-art" aria-hidden="true" data-scene>
  <svg class="draw" viewBox="12 66 326 282" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
    <path d={`M18 ${BASE + 26} H332`} stroke-width="1.1" opacity="0.5" pathLength="1"></path>
    <g data-depth="6">
      {arcs.map((d, i) => <path d={d} stroke-width="0.95" opacity="0.5" pathLength="1" style={`--i:${i}`} />)}
    </g>
    <g data-depth="14">
      {rings.map(({ r, d }, i) => <path d={d} stroke-width="1.1" opacity={r === 116 ? 0.9 : 0.6} pathLength="1" style={`--i:${20 + i * 4}`} />)}
    </g>
    <g data-depth="28" class="breathe">
      <path d="M175 82 V156 M155.5 108 H194.5" stroke-width="1.7" pathLength="1" style="--i:34"></path>
      <circle cx="175" cy="108" r="3" stroke-width="1.3" pathLength="1" style="--i:36"></circle>
    </g>
    <g data-depth="42">
      <path d={leftPage} stroke-width="1.6" pathLength="1" style="--i:38"></path>
      <path d={rightPage} stroke-width="1.6" pathLength="1" style="--i:38"></path>
      <path d={cover} stroke-width="1.3" opacity="0.8" pathLength="1" style="--i:42"></path>
      {lines.map((d, i) => <path d={d} stroke-width="0.9" opacity="0.6" pathLength="1" style={`--i:${44 + i}`} />)}
    </g>
  </svg>
</div>

<style>
  .hero-art {
    color: var(--accent);
    pointer-events: none;
  }

  svg {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }
</style>
