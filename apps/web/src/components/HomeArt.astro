---
/**
 * Line drawing under the home page cards: an open book on a baseline, a Coptic cross above it with rays,
 * and arcs rising from the line on both sides like the cross-reference diagram. It sits below the cards
 * in the page flow, so nothing covers it. Decorative only; it takes the theme's accent colour.
 */
const BASE = 350;
const CENTER = 600;

/** Semicircles on the baseline, [from, to]; the left set is mirrored to the right. */
const LEFT_ARCS: [number, number][] = [
  [20, 120],
  [50, 220],
  [90, 180],
  [130, 330],
  [170, 260],
  [210, 400],
  [260, 350],
  [300, 470],
  [380, 520],
];
const arcs = [...LEFT_ARCS, ...LEFT_ARCS.map(([a, b]): [number, number] => [1200 - b, 1200 - a])];
const arcPath = ([from, to]: [number, number]): string => {
  const r = (to - from) / 2;
  return `M${from} ${BASE} A${r} ${r} 0 0 1 ${to} ${BASE}`;
};

const rays = Array.from({ length: 41 }, (_, i) => {
  const angle = ((-175 + i * 4.25) * Math.PI) / 180;
  const inner = 66;
  const outer = i % 4 === 0 ? 118 : 92;
  const x = (r: number) => (CENTER + r * Math.cos(angle)).toFixed(1);
  const y = (r: number) => (225 + r * Math.sin(angle)).toFixed(1);
  return `M${x(inner)} ${y(inner)} L${x(outer)} ${y(outer)}`;
});
const arms = [0, 90, 180, 270];
---

<div class="art" aria-hidden="true">
  <svg viewBox="0 0 1200 360" preserveAspectRatio="xMidYMax slice" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
    {arcs.map((arc) => <path d={arcPath(arc)} opacity="0.75" />)}
    <path d={`M0 ${BASE} H1200`}></path>
    <path d={`M0 ${BASE + 7} H1200`} opacity="0.45"></path>

    <path d={rays.join(' ')}></path>
    <path d={`M${CENTER - 140} 225 A140 140 0 0 1 ${CENTER + 140} 225`}></path>
    <path d={`M${CENTER - 60} 225 A60 60 0 0 1 ${CENTER + 60} 225`} opacity="0.6"></path>

    <g transform={`translate(${CENTER} 225) scale(3.1) translate(-16 -16)`}>
      <rect x="13.5" y="6" width="5" height="20" rx="0.5"></rect>
      <rect x="6" y="13.5" width="20" height="5" rx="0.5"></rect>
      {
        arms.map((angle) => (
          <g transform={`rotate(${angle} 16 16)`}>
            <circle cx="16" cy="2.6" r="1.9" />
            <circle cx="12.7" cy="4.4" r="1.6" />
            <circle cx="19.3" cy="4.4" r="1.6" />
          </g>
        ))
      }
    </g>

    <g transform={`translate(${CENTER} ${BASE}) scale(1.55)`}>
      <path d="M0 0 C-20 -12 -62 -14 -90 -4 V-46 C-62 -56 -20 -54 0 -42 C20 -54 62 -56 90 -46 V-4 C62 -14 20 -12 0 0 Z"></path>
      <path d="M0 -42 V0"></path>
      <path d="M-76 -44 C-56 -48 -30 -46 -10 -38 M-76 -34 C-56 -38 -30 -36 -10 -28 M-76 -24 C-56 -28 -30 -26 -10 -18" opacity="0.6"></path>
      <path d="M76 -44 C56 -48 30 -46 10 -38 M76 -34 C56 -38 30 -36 10 -28 M76 -24 C56 -28 30 -26 10 -18" opacity="0.6"></path>
    </g>
  </svg>
</div>

<style>
  .art {
    overflow: hidden;
    pointer-events: none;
    color: var(--accent);
    opacity: 0.6;
    /* Tall enough for the whole drawing on wide screens, cropped to the middle on narrow ones. */
    block-size: clamp(15rem, 30vw, 27rem);
  }

  svg {
    display: block;
    inline-size: 100%;
    block-size: 100%;
  }

  :global(:root[data-theme='dark']) .art {
    opacity: 0.5;
  }

  svg :global(*) {
    vector-effect: non-scaling-stroke;
    stroke-width: 1.3;
  }
</style>
