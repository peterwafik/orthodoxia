---
/**
 * The homepage's signature image: real cross-references drawn as arcs over the canonical axis,
 * pre-computed by `scripts/generate-hero-arcs.ts`. Static SVG, so the homepage loads no WebGL.
 * The axis always runs Genesis → Revelation left to right, in both languages (UI proposal §4.7).
 */
import heroArcs from '../data/hero-arcs.json';
import { t, type Locale } from '../i18n/index.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale);

const WIDTH = 1000;
const BASE = 300;
const MAX_HEIGHT = 290;

function arcPath(from: number, to: number): string {
  const x1 = from * WIDTH;
  const x2 = to * WIDTH;
  const rx = (x2 - x1) / 2;
  // Scale every arc by the same ratio so the widest (Genesis–Revelation) just fits.
  const ry = rx * (MAX_HEIGHT / (WIDTH / 2));
  return `M${x1.toFixed(1)} ${BASE}A${rx.toFixed(1)} ${ry.toFixed(1)} 0 0 1 ${x2.toFixed(1)} ${BASE}`;
}

const arcs = heroArcs.arcs as [number, number, number][];
const within = arcs.filter(([, , crosses]) => crosses === 0).map(([a, b]) => arcPath(a, b)).join('');
const across = arcs.filter(([, , crosses]) => crosses === 1).map(([a, b]) => arcPath(a, b)).join('');
const newTestamentStart = heroArcs.books.find((book) => book.id === 'Matt')?.start ?? 0.77;
---

<figure class="hero-arcs" dir="ltr">
  <svg viewBox={`0 0 ${WIDTH} ${BASE}`} preserveAspectRatio="none" role="img" aria-label={strings.home.figureLabel}>
    <path class="within" d={within}></path>
    <path class="across" d={across}></path>
    <line x1="0" y1={BASE - 0.5} x2={WIDTH} y2={BASE - 0.5} class="axis"></line>
    {
      heroArcs.books.map((book) => (
        <line x1={book.start * WIDTH} y1={BASE - 6} x2={book.start * WIDTH} y2={BASE} class="tick" />
      ))
    }
  </svg>
  <div class="labels" aria-hidden="true">
    <span lang={locale} style="left: 0">{strings.home.axisOld}</span>
    <span class="nt" lang={locale} style={`--nt-start: ${(newTestamentStart * 100).toFixed(2)}%`}>{strings.home.axisNew}</span>
  </div>
</figure>

<style>
  .hero-arcs {
    margin: 0;
  }

  svg {
    display: block;
    inline-size: 100%;
    block-size: clamp(150px, 26vw, 320px);
    overflow: visible;
  }

  path {
    fill: none;
    stroke: var(--gold);
    vector-effect: non-scaling-stroke;
    animation: rise 1.6s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .within {
    stroke-width: 0.6;
    opacity: 0.22;
  }

  .across {
    stroke-width: 0.9;
    opacity: 0.85;
    animation-delay: 0.35s;
  }

  .axis,
  .tick {
    stroke: rgb(245 241 230 / 0.55);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .labels {
    position: relative;
    block-size: 1.6rem;
    margin-block-start: 0.4rem;
    font-size: var(--step--1);
    color: rgb(245 241 230 / 0.78);
  }

  .labels span {
    position: absolute;
    white-space: nowrap;
  }

  /* The New Testament label starts where Matthew starts, but never runs past the end of the axis. */
  .labels .nt {
    left: min(var(--nt-start), calc(100% - 9rem));
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(6%);
    }
  }
</style>
