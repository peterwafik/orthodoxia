---
/** Small thin-line icons for navigation (the same stroke weight as the site's line drawings). Decorative: the text beside each is its label. */
type Name = 'question' | 'compass' | 'scroll' | 'hourglass' | 'book' | 'scale' | 'bookmark' | 'search' | 'home' | 'menu' | 'info' | 'cross' | 'bible' | 'arcs' | 'chalice' | 'branch' | 'globe' | 'clock';
interface Props {
  name: Name;
  size?: number;
}
const { name, size = 22 } = Astro.props;
---

<svg class="line-icon" viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'question' && (<><circle cx="12" cy="12" r="9" /><path d="M9.5 9.5a2.5 2.5 0 1 1 3.6 2.2c-.7.4-1.1.9-1.1 1.8" /><path d="M12 17v.01" /></>)}
  {name === 'compass' && (<><circle cx="12" cy="12" r="9" /><path d="m15.5 8.5-2 5-5 2 2-5z" /></>)}
  {name === 'scroll' && (<><path d="M7 4h11a2 2 0 0 1 2 2v1H9" /><path d="M7 4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2V7" /><path d="M9 11h6M9 15h6" /></>)}
  {name === 'hourglass' && (<><path d="M7 3h10M7 21h10" /><path d="M8 3c0 5 8 5 8 9s-8 4-8 9M16 3c0 5-8 5-8 9s8 4 8 9" /></>)}
  {name === 'book' && (<><path d="M5 4h10a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3z" /><path d="M5 17a3 3 0 0 1 3-3h10" /></>)}
  {name === 'scale' && (<><path d="M12 4v16M7 20h10M5 8h14" /><path d="m5 8-2.5 6a3 3 0 0 0 5 0zM19 8l-2.5 6a3 3 0 0 0 5 0z" /></>)}
  {name === 'bookmark' && <path d="M7 4h10v16l-5-4-5 4z" />}
  {name === 'search' && (<><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4 4" /></>)}
  {name === 'home' && (<><path d="m4 11 8-7 8 7" /><path d="M6 10v10h12V10" /></>)}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === 'info' && (<><circle cx="12" cy="12" r="9" /><path d="M12 11v5M12 8v.01" /></>)}
  {name === 'cross' && <path d="M12 3v18M7 8h10" />}
  {name === 'bible' && (<><path d="M12 7C9 5 6 5 4 6v12c2-1 5-1 8 1z" /><path d="M12 7c3-2 6-2 8-1v12c-2-1-5-1-8 1z" /></>)}
  {name === 'globe' && (<><circle cx="12" cy="12" r="9" /><path d="M3 12h18" /><path d="M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18" /></>)}
  {name === 'clock' && (<><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3.5 2" /></>)}
  {name === 'arcs' && (<><path d="M3 18h18" /><path d="M5 18a7 7 0 0 1 14 0" /><path d="M8 18a4 4 0 0 1 8 0" /></>)}
  {name === 'chalice' && (<><path d="M7 5h10c0 4-2 6-5 6S7 9 7 5z" /><path d="M12 11v6M8 20h8M9.5 17h5" /></>)}
  {name === 'branch' && (<><path d="M4 12h6" /><path d="M10 12c3 0 3-6 6-6h4M10 12h10M10 12c3 0 3 6 6 6h4" /></>)}
</svg>
