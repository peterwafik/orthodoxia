---
import { CREDITED_SOURCES, LICENSE_LABELS } from '../lib/sources.ts';
import { localePath, t, type Locale } from '../i18n/index.ts';

interface Props {
  locale: Locale;
  /**
   * Reading pages: one quiet line. The attributions the licenses require (e.g. CC BY-SA for the
   * Arabic deuterocanon) stay one link away, on the Sources page.
   */
  minimal?: boolean;
}

const { locale, minimal = false } = Astro.props;
const strings = t(locale);
const REPOSITORY_URL = 'https://github.com/peterwafik/orthodoxia';
---

{minimal ? (
  <footer class="site-footer minimal">
    <div class="wrap">
      <a href={localePath(locale, 'sources')}>{strings.footer.sourcesAndLicenses}</a>
      <span aria-hidden="true">·</span>
      <a href={localePath(locale, 'about')}>{strings.nav.about}</a>
    </div>
  </footer>
) : (
<footer class="site-footer">
  <div class="wrap">
    <p class="notice">{strings.home.disclaimer}</p>
    <h2>{strings.footer.attributionHeading}</h2>
    <ul class="credits">
      {
        CREDITED_SOURCES.map((source) => (
          <li>
            <span lang="en" dir="ltr">
            {source.attribution ?? (
              <>
                <a href={source.url}>{source.title}</a> ({LICENSE_LABELS[source.license.id]})
              </>
            )}
            </span>
          </li>
        ))
      }
    </ul>
    <p>{strings.footer.code} {strings.footer.content}</p>
    <p>{strings.footer.fonts}</p>
    <p>
      <a href={localePath(locale, 'sources')}>{strings.nav.sources}</a>
      <span aria-hidden="true">&ensp;/&ensp;</span>
      <a href={REPOSITORY_URL}>{strings.footer.repo}</a>
    </p>
  </div>
</footer>
)}

<style>
  .minimal {
    margin-block-start: 3rem;
    padding-block: 1.25rem 1.75rem;
  }

  .minimal .wrap {
    display: flex;
    gap: 0.6rem;
    justify-content: center;
  }

  .minimal a {
    color: var(--ink-muted);
  }

  .site-footer {
    margin-block-start: 4rem;
    padding-block: 2.5rem 3rem;
    border-block-start: 1px solid var(--line);
    color: var(--ink-muted);
    font-size: var(--step--1);
  }

  h2 {
    font-family: var(--font-ui);
    font-size: var(--step-0);
    color: var(--ink);
    margin-block: 2rem 0.5rem;
  }

  .credits {
    margin: 0 0 1rem;
    padding-inline-start: 1.1rem;
    max-inline-size: 60rem;
  }

  .credits li + li {
    margin-block-start: 0.35rem;
  }

  .credits li {
    text-align: start;
    overflow-wrap: anywhere;
  }
</style>
