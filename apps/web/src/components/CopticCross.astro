---
/**
 * The brand mark: an equal-armed Coptic cross whose arms each end in three points (twelve in all,
 * traditionally read as the twelve apostles). Decorative; the site name beside it is the label.
 */
interface Props {
  size?: number;
}
const { size = 26 } = Astro.props;
const arms = [0, 90, 180, 270];
---

<svg class="cross" viewBox="0 0 32 32" width={size} height={size} aria-hidden="true">
  <g fill="currentColor">
    <rect x="13.5" y="6" width="5" height="20" rx="0.5"></rect>
    <rect x="6" y="13.5" width="20" height="5" rx="0.5"></rect>
    {
      arms.map((angle) => (
        <g transform={`rotate(${angle} 16 16)`}>
          <circle cx="16" cy="2.6" r="1.9" />
          <circle cx="12.7" cy="4.4" r="1.6" />
          <circle cx="19.3" cy="4.4" r="1.6" />
        </g>
      ))
    }
  </g>
</svg>

<style>
  .cross {
    color: var(--accent);
    flex: none;
  }
</style>
