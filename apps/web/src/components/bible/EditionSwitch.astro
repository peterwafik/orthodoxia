---
/**
 * Every edition in both languages, each linking to the same place (book and chapter) where it
 * exists there. Psalm numbering and differently packaged books are handled by `equivalentPath`.
 */
import { EDITIONS } from '@orthodoxia/bible';
import { biblePath, equivalentPath } from '../../lib/bible.ts';
import { t, type Locale } from '../../i18n/index.ts';

interface Props {
  locale: Locale;
  edition: string;
  book?: string;
  chapter?: number | null;
}

const { locale, edition, book, chapter = null } = Astro.props;
const strings = t(locale).bible;
const links = EDITIONS.map((candidate) => ({
  edition: candidate,
  href:
    book === undefined
      ? biblePath(candidate.locale, candidate.id)
      : equivalentPath(edition, candidate.id, book, chapter),
}));
---

<nav class="editions" aria-label={strings.editions}>
  <ul>
    {
      links.map(({ edition: candidate, href }) => (
        <li>
          <a
            href={href}
            lang={candidate.locale}
            hreflang={candidate.locale}
            title={candidate.name}
            aria-current={candidate.id === edition ? 'true' : undefined}
          >
            {candidate.shortName}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-block-size: 40px;
    padding-inline: 0.9rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink);
    text-decoration: none;
    font-size: var(--step--1);
    font-weight: 600;
  }

  a:hover {
    border-color: var(--accent);
  }

  a[aria-current='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--surface);
  }
</style>
