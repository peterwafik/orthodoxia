---
/**
 * The interpretation of a verse, shown only when the reader selects that verse: a bubble that opens
 * just below it, with an arrow pointing at where it was tapped. Closes with ✕, Escape or a tap
 * elsewhere; the selection is kept in the address (#v16) so a shared link opens it again.
 *
 * Every entry is in a <template> (not rendered until needed); the bubble shows the entries whose
 * verse range covers the selected verse, or, where no text is available, where to read more.
 */
import type { ChapterCommentary } from '../../lib/commentary.ts';
import { t, type Locale } from '../../i18n/index.ts';

interface Props {
  locale: Locale;
  commentary: ChapterCommentary | null;
  /** For editions in another language: the same chapter in the Arabic edition. */
  arabicHref?: string | undefined;
  /** Cross-reference explorer address for a verse: `{verse}` is replaced. */
  explorerHref?: string | undefined;
}

const { locale, commentary, arabicHref, explorerHref } = Astro.props;
const strings = t(locale).commentary;
const text = arabicHref === undefined ? (commentary?.stMark ?? null) : null;
// English editions: the St. Mark commentary in its English translation, where translated.
const english = arabicHref !== undefined ? (commentary?.stMarkEnglish ?? null) : null;
// Where St. Mark has no text: Fr. Tadros Malaty's commentary, credited on every entry.
const malaty = arabicHref === undefined && text === null ? (commentary?.malaty ?? null) : null;
const malatyEnglish = arabicHref !== undefined && english === null && commentary?.malaty ? commentary.malatyEnglish : null;
const hasText = text !== null || english !== null || malaty !== null || malatyEnglish !== null;
const kindClass = (kind: string | undefined) => (kind === undefined ? undefined : `p-${kind}`);
---

<template id="verse-bubble-data">
  {
    english !== null &&
      english.entries.map((entry) => (
        <article class="entry" data-start={entry.verses[0]} data-end={entry.verses[1]} lang="en" dir="ltr">
          {entry.verses[0] !== entry.verses[1] && <p class="range">{t('en').commentary.verses(entry.verses[0], entry.verses[1])}</p>}
          {entry.paragraphs.map((paragraph) => (
            <p class={kindClass(paragraph.kind)}>{paragraph.text}</p>
          ))}
        </article>
      ))
  }
  {
    malatyEnglish !== null &&
      malatyEnglish.entries.map((entry) => (
        <article class="entry" data-start={entry.verses[0]} data-end={entry.verses[1]} lang="en" dir="ltr">
          {entry.verses[0] !== entry.verses[1] && <p class="range">{t('en').commentary.verses(entry.verses[0], entry.verses[1])}</p>}
          {entry.paragraphs.map((paragraph) => (
            <p class={kindClass(paragraph.kind)}>{paragraph.text}</p>
          ))}
          <p class="translation-note" lang={locale}>{strings.malatyCredit}.</p>
        </article>
      ))
  }
  {
    malaty !== null &&
      malaty.chapter.entries.map((entry) => (
        <article class="entry" data-start={entry.verses[0]} data-end={entry.verses[1]} lang="ar" dir="rtl">
          {entry.verses[0] !== entry.verses[1] && <p class="range">{t('ar').commentary.verses(entry.verses[0], entry.verses[1])}</p>}
          {entry.paragraphs.map((paragraph) => (
            <p class={kindClass(paragraph.kind)}>{paragraph.text}</p>
          ))}
          <p class="translation-note" lang={locale}>{strings.malatyOriginal}</p>
        </article>
      ))
  }
  {
    text !== null &&
      text.chapter.entries.map((entry) => (
        <article class="entry" data-start={entry.verses[0]} data-end={entry.verses[1]} lang="ar" dir="rtl">
          {entry.verses[0] !== entry.verses[1] && <p class="range">{t('ar').commentary.verses(entry.verses[0], entry.verses[1])}</p>}
          {entry.paragraphs.map((paragraph) => (
            <p class={kindClass(paragraph.kind)}>{paragraph.text}</p>
          ))}
        </article>
      ))
  }
  <div class="fallback">{hasText && <p class="muted">{strings.noEntryForVerse}</p>}</div>
  {explorerHref !== undefined && <a class="action explore" href={explorerHref}>{strings.crossReferences}</a>}
</template>

<div
  class="verse-bubble"
  role="dialog"
  aria-modal="false"
  tabindex="-1"
  hidden
  data-title={strings.forVerse('{verse}')}
  data-has-text={hasText ? '' : undefined}
>
  <span class="arrow" aria-hidden="true"></span>
  <header>
    <h2 class="title"></h2>
    <button type="button" class="close" aria-label={strings.close}>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
    </button>
  </header>
  <div class="body"></div>
</div>

<script>
  const bubble = document.querySelector<HTMLElement>('.verse-bubble');
  const data = document.querySelector<HTMLTemplateElement>('#verse-bubble-data');
  const text = document.querySelector<HTMLElement>('.chapter-text');
  const host = text?.parentElement;
  if (bubble !== null && data !== null && text !== null && host) {
    const title = bubble.querySelector<HTMLElement>('.title')!;
    const body = bubble.querySelector<HTMLElement>('.body')!;
    const arrow = bubble.querySelector<HTMLElement>('.arrow')!;
    const entries = [...data.content.querySelectorAll<HTMLElement>('.entry')];
    const fallback = data.content.querySelector<HTMLElement>('.fallback');
    const explore = data.content.querySelector<HTMLAnchorElement>('.explore');
    let selected: HTMLElement | null = null;
    let returnFocus: HTMLElement | null = null;

    const close = () => {
      bubble.hidden = true;
      selected?.classList.remove('selected');
      selected = null;
      if (/^#v\d+$/.test(location.hash)) history.replaceState(null, '', location.pathname + location.search);
      returnFocus?.focus({ preventScroll: true });
      returnFocus = null;
    };

    const open = (verse: number, clientX: number | null) => {
      const element = document.getElementById(`v${verse}`);
      if (element === null) return;
      selected?.classList.remove('selected');
      selected = element;
      element.classList.add('selected');

      // Contents: the entries covering this verse, else where to read more; then cross-references.
      body.replaceChildren();
      const matching = entries.filter((entry) => verse >= Number(entry.dataset['start']) && verse <= Number(entry.dataset['end']));
      for (const entry of matching) {
        const copy = entry.cloneNode(true) as HTMLElement;
        copy.querySelectorAll('a').forEach((link) => link.setAttribute('href', link.getAttribute('href')!.replace('{verse}', String(verse))));
        body.append(copy);
      }
      if (matching.length === 0 && fallback !== null) {
        const copy = fallback.cloneNode(true) as HTMLElement;
        copy.querySelectorAll('a').forEach((link) => link.setAttribute('href', link.getAttribute('href')!.replace('{verse}', String(verse))));
        if (copy.textContent?.trim()) body.append(copy);
      }
      if (explore !== null) {
        const link = explore.cloneNode(true) as HTMLAnchorElement;
        link.href = link.getAttribute('href')!.replace('{verse}', String(verse));
        body.append(link);
      }
      title.textContent = (bubble.dataset['title'] ?? '').replace('{verse}', String(verse));
      bubble.setAttribute('aria-label', title.textContent);

      // Position: under the verse's last line, the arrow at the tap (or the verse's start).
      bubble.hidden = false;
      const hostBox = host.getBoundingClientRect();
      const rects = [...element.getClientRects()];
      const last = rects.at(-1) ?? element.getBoundingClientRect();
      const first = rects[0] ?? last;
      bubble.style.top = `${last.bottom - hostBox.top + 10}px`;
      const rtl = getComputedStyle(text).direction === 'rtl';
      const anchorX = clientX ?? (rtl ? first.right - 12 : first.left + 12);
      const width = bubble.offsetWidth;
      const left = Math.min(Math.max(anchorX - hostBox.left - width / 2, 0), hostBox.width - width);
      bubble.style.left = `${Math.max(left, 0)}px`;
      arrow.style.left = `${Math.min(Math.max(anchorX - hostBox.left - Math.max(left, 0) - 8, 14), width - 30)}px`;
      body.scrollTop = 0;
      const box = bubble.getBoundingClientRect();
      if (box.bottom > window.innerHeight || box.top < 0) {
        bubble.scrollIntoView({ block: box.height > window.innerHeight * 0.8 ? 'start' : 'nearest', behavior: 'smooth' });
      }
    };

    text.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (target.closest('.fn') !== null) return;
      const verseElement = target.closest<HTMLElement>('[id^="v"]');
      if (verseElement === null) return;
      const verse = Number.parseInt(verseElement.id.slice(1), 10);
      if (Number.isNaN(verse)) return;
      event.preventDefault();
      if (selected === verseElement && !bubble.hidden) {
        close();
        return;
      }
      returnFocus = verseElement.querySelector<HTMLElement>('.vn') ?? null;
      history.replaceState(null, '', `#v${verse}`);
      open(verse, event.detail === 0 ? null : event.clientX);
      if (event.detail === 0) bubble.focus();
    });
    bubble.querySelector('.close')?.addEventListener('click', close);
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !bubble.hidden) close();
    });
    document.addEventListener('pointerdown', (event) => {
      const target = event.target as HTMLElement;
      if (!bubble.hidden && !bubble.contains(target) && target.closest('.chapter-text [id^="v"]') === null) close();
    });
    window.addEventListener('resize', () => {
      if (!bubble.hidden && selected !== null) open(Number(selected.id.slice(1)), null);
    });
    const fromHash = () => {
      const match = /^#v(\d+)$/.exec(location.hash);
      if (match !== null) open(Number(match[1]), null);
    };
    window.addEventListener('hashchange', fromHash);
    fromHash();
  }
</script>

<style>
  .verse-bubble {
    position: absolute;
    z-index: 5;
    inline-size: min(34rem, 100%);
    max-block-size: min(60vh, 32rem);
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface-raised);
    box-shadow: 0 12px 32px rgb(14 26 51 / 0.18);
    animation: bubble-in 0.16s ease-out;
  }

  .verse-bubble[hidden] {
    display: none;
  }

  .verse-bubble:focus {
    outline: none;
  }

  .arrow {
    position: absolute;
    inset-block-start: -8px;
    inline-size: 16px;
    block-size: 16px;
    background: var(--surface-raised);
    border-inline-start: 1px solid var(--line);
    border-block-start: 1px solid var(--line);
    transform: rotate(45deg);
  }

  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.6rem 0.75rem 0.25rem 1rem;
  }

  .title {
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--accent);
  }

  .close {
    display: inline-grid;
    place-items: center;
    inline-size: 36px;
    block-size: 36px;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--ink-muted);
    cursor: pointer;
  }

  .close:hover {
    background: var(--line);
    color: var(--ink);
  }

  .body {
    overflow-y: auto;
    padding: 0 1rem 1rem;
    font-family: 'Noto Naskh Arabic Variable', var(--font-reading);
    font-size: 1.0625rem;
    line-height: 1.95;
  }

  .body :global(.entry + .entry) {
    margin-block-start: 1rem;
    padding-block-start: 1rem;
    border-block-start: 1px solid var(--line);
  }

  .body :global(p) {
    margin-block: 0 0.5rem;
  }

  .body :global(.range) {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .body :global(.p-point) {
    padding-inline-start: 0.75rem;
  }

  .body :global(.p-reflection) {
    padding: 0.5rem 0.75rem;
    border-inline-start: 3px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 7%, transparent);
  }

  .body :global(.original),
  .body :global(.action) {
    display: inline-block;
    margin-block-start: 0.25rem;
    font-family: var(--font-ui);
    font-size: var(--step--1);
  }

  .body :global(.action) {
    display: block;
  }

  .body :global(.entry[lang='en']) {
    font-family: var(--font-reading);
    line-height: 1.7;
  }

  .body :global(.translation-note) {
    margin-block-start: 0.5rem;
    color: var(--ink-muted);
    font-family: var(--font-ui);
    font-size: var(--step--1);
    line-height: 1.5;
  }

  .body :global(.muted) {
    color: var(--ink-muted);
    font-family: var(--font-ui);
    font-size: var(--step--1);
  }

  @keyframes bubble-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }
</style>
