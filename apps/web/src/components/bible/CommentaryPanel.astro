---
/**
 * The interpretation beside the chapter text. Without JavaScript it lists the whole chapter's
 * commentary; with it, selecting a verse (its number, or the verse itself) shows only the entries
 * that cover that verse, and "Show the whole chapter" returns to the full list. The selection is
 * kept in the address (#v16), so a link opens on the same verse.
 */
import type { ChapterCommentary } from '../../lib/commentary.ts';
import { t, type Locale } from '../../i18n/index.ts';

interface Props {
  locale: Locale;
  commentary: ChapterCommentary;
  /** For editions in another language: the same chapter in the Arabic edition. */
  arabicHref?: string | undefined;
  /** Deuterocanonical books: the commentary follows the Church edition's verse numbering. */
  differentNumbering?: boolean;
}

const { locale, commentary, arabicHref, differentNumbering = false } = Astro.props;
const strings = t(locale).commentary;
const showText = commentary.stMark !== null && arabicHref === undefined;
const kindClass = (kind: string | undefined) => (kind === undefined ? undefined : `p-${kind}`);
---

<aside
  class="commentary"
  id="commentary"
  aria-labelledby="commentary-title"
  data-commentary={showText ? 'text' : 'links'}
  data-for-verse={strings.forVerse('{verse}')}
>
  <h2 id="commentary-title">{strings.title}</h2>

  {
    showText && commentary.stMark !== null && (
      <>
        <p class="source">{strings.stMark}</p>
        <div class="controls">
          <p class="status" data-status aria-live="polite">
            {strings.chooseVerse}
          </p>
          <button type="button" class="show-all" data-show-all hidden>
            {strings.showAll}
          </button>
        </div>
        {commentary.stMark.repaired && <p class="notice">{strings.repairedNotice}</p>}
        {differentNumbering && <p class="notice">{strings.numberingNotice}</p>}
        <div class="entries" lang="ar" dir="rtl">
          {commentary.stMark.chapter.intro.length > 0 && (
            <div class="intro" data-intro>
              {commentary.stMark.chapter.intro.map((paragraph) => (
                <p class={kindClass(paragraph.kind)}>{paragraph.text}</p>
              ))}
            </div>
          )}
          {commentary.stMark.chapter.entries.map((entry) => (
            <article class="entry" data-start={entry.verses[0]} data-end={entry.verses[1]}>
              <h3>
                <span class="range">{t('ar').commentary.verses(entry.verses[0], entry.verses[1])}</span>
                {entry.section !== null && <span class="section">{entry.section}</span>}
              </h3>
              {entry.paragraphs.map((paragraph) => (
                <p class={kindClass(paragraph.kind)}>{paragraph.text}</p>
              ))}
              <a class="original" href={`${commentary.stMark!.documentUrl}#page=${entry.page}`} rel="noopener" target="_blank" lang={locale}>
                {strings.original(entry.page)}
              </a>
            </article>
          ))}
          <p class="empty" data-empty hidden lang={locale}>
            {strings.noEntryForVerse}
          </p>
        </div>
        <p class="attribution">{strings.attribution}</p>
      </>
    )
  }

  {
    !showText && (
      <div class="links">
        {commentary.stMark !== null && arabicHref !== undefined && (
          <>
            <p>{strings.arabicOnly}</p>
            <p>
              <a href={`${arabicHref}#commentary`} hreflang="ar">{strings.readArabic}</a>
            </p>
            <p class="muted">{strings.englishPending}</p>
          </>
        )}
        {commentary.stMark === null && commentary.stMarkPdf !== null && (
          <>
            <p>{strings.pdfOnly}</p>
            <p>
              <a href={commentary.stMarkPdf} rel="noopener" target="_blank">{strings.openPdf}</a>
            </p>
          </>
        )}
        {commentary.stMark === null && commentary.malatyUrl !== null && (
          <p>
            <a href={commentary.malatyUrl} rel="noopener" target="_blank">{strings.malaty}</a>
            <span class="muted"> {strings.malatyNote}</span>
          </p>
        )}
        {commentary.stMark === null && commentary.stMarkPdf === null && commentary.malatyUrl === null && <p class="muted">{strings.none}</p>}
      </div>
    )
  }
</aside>

<script>
  // Verse selection → the entries covering that verse. Runs only where the commentary text is shown.
  const panel = document.querySelector<HTMLElement>('[data-commentary="text"]');
  if (panel !== null) {
    const entries = [...panel.querySelectorAll<HTMLElement>('.entry')];
    const intro = panel.querySelector<HTMLElement>('[data-intro]');
    const empty = panel.querySelector<HTMLElement>('[data-empty]');
    const status = panel.querySelector<HTMLElement>('[data-status]');
    const showAll = panel.querySelector<HTMLButtonElement>('[data-show-all]');
    const defaultStatus = status?.textContent ?? '';
    const forVerse = panel.dataset['forVerse'] ?? '';
    let selected: HTMLElement | null = null;

    const select = (verse: number | null, scroll: boolean) => {
      selected?.classList.remove('selected');
      selected = verse === null ? null : document.getElementById(`v${verse}`);
      selected?.classList.add('selected');
      let shown = 0;
      for (const entry of entries) {
        const start = Number(entry.dataset['start']);
        const end = Number(entry.dataset['end']);
        const match = verse === null || (verse >= start && verse <= end);
        entry.hidden = !match;
        if (match) shown++;
      }
      if (intro !== null) intro.hidden = verse !== null;
      if (empty !== null) empty.hidden = verse === null || shown > 0;
      if (showAll !== null) showAll.hidden = verse === null;
      if (status !== null) status.textContent = verse === null ? defaultStatus : forVerse.replace('{verse}', String(verse));
      if (verse === null && empty !== null) empty.hidden = true;
      if (scroll) {
        const narrow = window.matchMedia('(max-width: 63.99rem)').matches;
        if (narrow) panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
        else panel.scrollTop = 0;
      }
    };

    // Verse numbers keep their own link (#v16) for sharing; a click also selects the verse.
    document.querySelector('.chapter-text')?.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      const verseElement = target.closest<HTMLElement>('[id^="v"]');
      if (verseElement === null || target.closest('.fn') !== null) return;
      const verse = Number.parseInt(verseElement.id.slice(1), 10);
      if (Number.isNaN(verse)) return;
      event.preventDefault();
      history.replaceState(null, '', `#v${verse}`);
      select(verse, true);
    });
    showAll?.addEventListener('click', () => {
      history.replaceState(null, '', location.pathname);
      select(null, false);
    });
    const fromHash = () => {
      const match = /^#v(\d+)$/.exec(location.hash);
      select(match === null ? null : Number(match[1]), false);
    };
    window.addEventListener('hashchange', fromHash);
    fromHash();
  }
</script>

<style>
  .commentary {
    font-size: var(--step--1);
  }

  .commentary h2 {
    font-size: var(--step-1);
    margin-block-end: 0.25rem;
  }

  .source {
    color: var(--accent);
    font-weight: 600;
    margin-block-end: 0.75rem;
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    padding-block: 0.75rem;
    border-block: 1px solid var(--line);
    margin-block-end: 1rem;
  }

  .status {
    margin: 0;
    flex: 1 1 14rem;
    color: var(--ink-muted);
  }

  .show-all {
    min-block-size: 40px;
    padding-inline: 0.9rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: none;
    color: var(--ink);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .show-all:hover {
    border-color: var(--accent);
  }

  .notice {
    margin-block: 0 1rem;
  }

  .entries {
    font-family: 'Noto Naskh Arabic Variable', serif;
    font-size: 1.125rem;
    line-height: 2;
  }

  .entry {
    padding-block: 1.25rem;
    border-block-start: 1px solid var(--line);
  }

  .entry h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    margin-block-end: 0.5rem;
    font-family: var(--font-ui);
    font-size: var(--step-0);
  }

  .range {
    color: var(--accent);
    font-weight: 700;
  }

  .section {
    color: var(--ink-muted);
    font-weight: 500;
    font-size: var(--step--1);
  }

  .entries p {
    margin-block: 0 0.6rem;
  }

  .p-point {
    padding-inline-start: 1rem;
  }

  .p-reflection {
    padding: 0.6rem 0.9rem;
    border-inline-start: 3px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 7%, transparent);
  }

  .original {
    font-family: var(--font-ui);
    font-size: var(--step--1);
  }

  .attribution,
  .muted {
    color: var(--ink-muted);
  }

  .attribution {
    margin-block-start: 1.5rem;
  }

  .links p {
    margin-block: 0 0.75rem;
  }
</style>
