---
import type { Section } from '@orthodoxia/bible';
import { biblePath, bookName, editionBooks } from '../../lib/bible.ts';
import { localePath, t, type Locale } from '../../i18n/index.ts';
import LineIcon from '../LineIcon.astro';
import { LIVE_PLANS } from '../../lib/plans/catalog.ts';

interface Props {
  locale: Locale;
  edition: string;
}

const { locale, edition: editionId } = Astro.props;
const strings = t(locale).bible;
const books = editionBooks(editionId);
const sections = (['ot', 'deuterocanon', 'nt'] as const satisfies readonly Section[])
  .map((section) => ({ section, books: books.filter(({ info }) => info.section === section) }))
  .filter(({ books: list }) => list.length > 0);
/** A pointer to the reading plans, for readers who do not know where to start (shown once a plan is live). */
const plans = LIVE_PLANS.length === 0
  ? null
  : locale === 'ar'
    ? { title: 'لا تعرف من أين تبدأ؟ جرّب خطط القراءة', note: 'أجب عن أربعة أسئلة سريعة، ثم اقرأ قليلًا كل يوم، فكرة واحدة في كل مرة.', cta: 'اعثر على خطتك' }
    : { title: 'Not sure where to start? Try a reading plan', note: 'Answer four quick questions, then read a little each day, one idea at a time.', cta: 'Find your plan' };
---

<div class="wrap section">
  <h1>{strings.title}</h1>
  <p class="prose">{strings.intro}</p>

  {plans !== null && (
    <a class="plans" href={localePath(locale, 'plans')}>
      <span class="plans-icon"><LineIcon name="compass" /></span>
      <span class="plans-text"><b>{plans.title}</b><small>{plans.note}</small></span>
      <span class="plans-cta">{plans.cta}</span>
    </a>
  )}

  {
    sections.map(({ section, books: list }) => (
      <section aria-labelledby={`section-${section}`}>
        <h2 id={`section-${section}`}>{strings.sections[section]}</h2>
        <ol class="books">
          {list.map(({ info, chapters }) => (
            <li>
              <a href={biblePath(locale, editionId, info, chapters.length === 1 ? chapters[0] : undefined)}>
                {bookName(info, locale)}
              </a>
              <span class="count">{chapters.length}</span>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</div>

<style>
  .plans {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
    margin-block-start: 1.25rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--line);
    border-inline-start: 5px solid var(--accent);
    border-radius: 0.9rem;
    background: var(--surface-raised);
    color: var(--ink);
    text-decoration: none;
  }

  .plans-icon {
    display: inline-grid;
    inline-size: 2rem;
    block-size: 2rem;
    color: var(--accent);
    flex: none;
  }

  .plans-text {
    display: grid;
    gap: 0.15rem;
    flex: 1 1 16rem;
  }

  .plans-text small {
    color: var(--ink-muted);
  }

  .plans-cta {
    font-weight: 600;
    color: var(--accent);
  }

  h1 {
    font-size: var(--step-3);
  }

  section {
    margin-block-start: 2.5rem;
  }

  h2 {
    font-size: var(--step-2);
  }

  .notice {
    font-size: var(--step--1);
    margin-block-end: 1rem;
  }

  .books {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: 0 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .books li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    border-block-end: 1px solid var(--line);
  }

  .books a {
    display: block;
    padding-block: 0.6rem;
    font-family: var(--font-reading);
    font-size: 1.0625rem;
    color: var(--ink);
    text-decoration: none;
  }

  .books a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .count {
    color: var(--ink-muted);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
  }
</style>
