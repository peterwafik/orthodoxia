---
import { getEdition, type Section } from '@orthodoxia/bible';
import EditionSwitch from './EditionSwitch.astro';
import { biblePath, bookName, editionBooks } from '../../lib/bible.ts';
import { t, type Locale } from '../../i18n/index.ts';

interface Props {
  locale: Locale;
  edition: string;
}

const { locale, edition: editionId } = Astro.props;
const strings = t(locale).bible;
const edition = getEdition(editionId)!;
const books = editionBooks(editionId);
const sections = (['ot', 'deuterocanon', 'nt'] as const satisfies readonly Section[])
  .map((section) => ({ section, books: books.filter(({ info }) => info.section === section) }))
  .filter(({ books: list }) => list.length > 0);
---

<div class="wrap section">
  <h1>{strings.title}</h1>
  <p class="prose">{strings.intro}</p>
  <EditionSwitch locale={locale} edition={editionId} />
  <p class="edition-name" lang={edition.locale}>
    <strong>{edition.name}.</strong>{' '}{edition.description}
  </p>

  {
    sections.map(({ section, books: list }) => (
      <section aria-labelledby={`section-${section}`}>
        <h2 id={`section-${section}`}>{strings.sections[section]}</h2>
        {section === 'deuterocanon' && <p class="notice">{strings.deuterocanonNote}</p>}
        <ol class="books">
          {list.map(({ info, chapters }) => (
            <li>
              <a href={biblePath(locale, editionId, info, chapters.length === 1 ? chapters[0] : undefined)}>
                {bookName(info, locale)}
              </a>
              <span class="count">{chapters.length}</span>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</div>

<style>
  h1 {
    font-size: var(--step-3);
  }

  .edition-name {
    max-inline-size: var(--measure);
    margin-block: 1rem 0;
    color: var(--ink-muted);
    font-size: var(--step--1);
  }

  section {
    margin-block-start: 2.5rem;
  }

  h2 {
    font-size: var(--step-2);
  }

  .notice {
    font-size: var(--step--1);
    margin-block-end: 1rem;
  }

  .books {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: 0 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .books li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    border-block-end: 1px solid var(--line);
  }

  .books a {
    display: block;
    padding-block: 0.6rem;
    font-family: var(--font-reading);
    font-size: 1.0625rem;
    color: var(--ink);
    text-decoration: none;
  }

  .books a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .count {
    color: var(--ink-muted);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
  }
</style>
