---
/**
 * The background of the church-history page: one grapevine in hairlines, climbing the margin at the start of the
 * page (the left in English, the right in Arabic). It appears only where there is room for it, so it never sits
 * behind the timeline. Decorative only; it takes the theme's accent colour.
 */
const TILE = 320;
const stemX = (y: number): number => 32 + 10 * Math.sin((2 * Math.PI * y) / TILE);

const stem = Array.from({ length: TILE / 4 + 1 }, (_, i) => i * 4)
  .map((y, i) => `${i === 0 ? 'M' : 'L'}${stemX(y).toFixed(1)} ${y}`)
  .join(' ');

/** A leaf growing from the stem at height y, to the right (1) or the left (-1). */
const leaf = (y: number, side: 1 | -1): string => {
  const x = stemX(y);
  const tipX = x + side * 36;
  return (
    `M${x.toFixed(1)} ${y} Q${(x + side * 24).toFixed(1)} ${y - 20} ${tipX.toFixed(1)} ${y - 4} ` +
    `Q${(x + side * 20).toFixed(1)} ${y + 12} ${x.toFixed(1)} ${y} ` +
    `M${x.toFixed(1)} ${y} L${(x + side * 26).toFixed(1)} ${y - 5}`
  );
};

/** A hanging cluster of grapes under the stem at height y. */
const grapes = (y: number, side: 1 | -1): { stalk: string; berries: [number, number][] } => {
  const x = stemX(y) + side * 5;
  const rows: [number, number][] = [
    [-8, 0],
    [0, 0],
    [8, 0],
    [-4, 8],
    [4, 8],
    [0, 16],
  ];
  return {
    stalk: `M${stemX(y).toFixed(1)} ${y} Q${(x + side * 6).toFixed(1)} ${y + 6} ${x.toFixed(1)} ${y + 18}`,
    berries: rows.map(([dx, dy]): [number, number] => [x + dx, y + 22 + dy]),
  };
};

const leaves = [
  leaf(44, 1),
  leaf(124, -1),
  leaf(204, 1),
  leaf(284, -1),
];
const clusters = [grapes(76, 1), grapes(236, -1)];

/** A tendril curling away from the stem. */
const tendrils = [
  `M${stemX(164).toFixed(1)} 164 q12 -10 20 0 q6 10 -4 14 q-8 2 -8 -6`,
  `M${stemX(8).toFixed(1)} 8 q-12 -10 -20 0 q-6 10 4 14 q8 2 8 -6`,
];
---

<div class="art" aria-hidden="true">
  <svg class="vine" width="64" height="100%">
    <defs>
      <pattern id="ch-vine" width="64" height={TILE} patternUnits="userSpaceOnUse">
        <g fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
          <path d={stem}></path>
          {leaves.map((d) => <path d={d}></path>)}
          {tendrils.map((d) => <path d={d} stroke-width="1"></path>)}
          {
            clusters.map((cluster) => (
              <g>
                <path d={cluster.stalk} stroke-width="1"></path>
                {cluster.berries.map(([cx, cy]) => <circle cx={cx.toFixed(1)} cy={cy.toFixed(1)} r="4.4"></circle>)}
              </g>
            ))
          }
        </g>
      </pattern>
    </defs>
    <rect width="64" height="100%" fill="url(#ch-vine)"></rect>
  </svg>
</div>

<style>
  .art {
    display: none;
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0.6rem;
    inline-size: 64px;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    color: var(--accent);
    opacity: 0.55;
  }

  /* There is room for it only on wide screens; the page reserves this lane then. */
  @media (min-width: 64rem) {
    .art {
      display: block;
    }
  }

  :global(:root[data-theme='dark']) .art {
    opacity: 0.45;
  }

  .vine {
    display: block;
    block-size: 100%;
  }
</style>
