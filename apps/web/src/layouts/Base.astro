---
import '@fontsource-variable/inter';
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/noto-sans-arabic';
import '@fontsource-variable/noto-naskh-arabic';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { LOCALES, dir, switchLocalePath, t, type Locale } from '../i18n/index.ts';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
}

const { locale, title, description } = Astro.props;
const strings = t(locale);
const pageTitle = title === undefined ? strings.meta.siteName : `${title} | ${strings.meta.siteName}`;
const pageDescription = description ?? strings.meta.description;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={locale} dir={dir(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    {
      LOCALES.map((other) => (
        <link rel="alternate" hreflang={other} href={new URL(switchLocalePath(Astro.url.pathname, other), Astro.site)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'ar' ? 'ar_EG' : 'en_US'} />
    <meta name="theme-color" content="#0e1a33" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Apply a saved theme before first paint. Storage may be unavailable (private mode).
      try {
        const theme = localStorage.getItem('orthodoxia:theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">{strings.a11y.skipToContent}</a>
    <SiteHeader locale={locale} />
    <main id="content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter locale={locale} />
  </body>
</html>
