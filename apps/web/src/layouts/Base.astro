---
import '@fontsource-variable/inter';
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/noto-sans-arabic';
import '@fontsource-variable/noto-naskh-arabic';
import '../styles/global.css';
import '../styles/depth.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CommandPalette from '../components/CommandPalette.astro';
import { LOCALES, dir, otherLocale, switchLocalePath, t, type Locale } from '../i18n/index.ts';

interface Props {
  locale: Locale;
  title?: string;
  description?: string | undefined;
  /** The same page in each language, when it is not simply /en/… ↔ /ar/… (e.g. Bible chapters). */
  alternates?: Partial<Record<Locale, string>> | undefined;
  /** The canonical address, when this page duplicates another (e.g. /en/bible/ shows the KJV index). */
  canonicalPath?: string;
  /** The home page: the cards are the navigation, so the header keeps only the brand and the tools. */
  simpleHeader?: boolean;
  /** Keep this page out of search engines (unreviewed drafts). */
  noindex?: boolean;
  /** A full-screen experience (the Holy Mass journey): no phone dock. */
  immersive?: boolean;
}

const { locale, title, description, alternates = {}, canonicalPath, simpleHeader = false, noindex = false, immersive = false } = Astro.props;
const alternatePath = (other: Locale): string => alternates[other] ?? switchLocalePath(Astro.url.pathname, other);
const strings = t(locale);
const pageTitle = title === undefined ? strings.meta.siteName : `${title} | ${strings.meta.siteName}`;
const pageDescription = description ?? strings.meta.description;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={locale} dir={dir(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {
      LOCALES.map((other) => (
        <link rel="alternate" hreflang={other} href={new URL(alternatePath(other), Astro.site)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'ar' ? 'ar_EG' : 'en_US'} />
    <meta name="theme-color" content="#0e1a33" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Apply a saved theme before first paint. Storage may be unavailable (private mode).
      try {
        const theme = localStorage.getItem('orthodoxia:theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body data-immersive={immersive ? "" : undefined}>
    <a class="skip-link" href="#content">{strings.a11y.skipToContent}</a>
    <SiteHeader locale={locale} alternate={alternatePath(otherLocale(locale))} simple={simpleHeader} />
    <main id="content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter locale={locale} />
    <CommandPalette locale={locale} />
    <script>
      import '../lib/depth.ts';
    </script>
  </body>
</html>
