---
import Base from '../../layouts/Base.astro';
import { CHURCHES, COMPARE_GROUPS, COMPARE_POINTS, EVENTS, GROUPS, POSITIONS } from '../../data/church-history/index.ts';
import { layoutTimeline, DEFAULT_LAYOUT } from '../../lib/church-history/layout.ts';
import { COPTIC_EVIDENCE } from '../../data/coptic-evidence.ts';
import { evidenceRefs } from '../../lib/topics/evidence.ts';
import { FAMILIES } from '../../lib/topics/topics.ts';
import { LOCALES, localePath, t, type Locale } from '../../i18n/index.ts';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const strings = t(locale);
const copy = strings.churchHistory;

const layout = layoutTimeline(CHURCHES, EVENTS);
const threads = new Map(layout.threads.map((thread) => [thread.id, thread]));
/** Threads from the top lane to the bottom lane, which is also the order of the keyboard arrows. */
const ordered = [...CHURCHES].sort((a, b) => a.lane - b.lane);

const positionText = (pointId: string, positionId: string): string =>
  COMPARE_POINTS.find((point) => point.id === pointId)!.positions.find((position) => position.id === positionId)!.text[locale];
/** The text of a position as pieces, so the words that make it differ can be shown in bold (marked ** in the data). */
const pieces = (text: string) => text.split('**').map((piece, index) => ({ piece, bold: index % 2 === 1 }));
const copticPositions = POSITIONS['coptic-orthodox']!;
/** Where a church agrees with the Coptic Orthodox Church and where it differs, point by point. */
const versus = (churchId: string) => {
  const own = POSITIONS[churchId]!;
  const same: string[] = [];
  const differ: { label: string; text: string }[] = [];
  for (const point of COMPARE_POINTS) {
    const key = point.id as keyof typeof own;
    if (own[key] === copticPositions[key]) same.push(point.label[locale]);
    else differ.push({ label: point.label[locale], text: positionText(point.id, own[key]!) });
  }
  return { same, differ };
};
/** A link into the Bible reader, to the first verse the Coptic Church cites for a point, with its evidence open. */
const evidenceFamily = FAMILIES.find((family) => family.id === '44')!;
const evidenceHref = (pointId: string): string | undefined => {
  const point = COMPARE_POINTS.find((candidate) => candidate.id === pointId)!;
  const entry = COPTIC_EVIDENCE.find((candidate) => candidate.point === pointId);
  const topic = evidenceFamily.topics.find((candidate) => candidate.en === point.label.en);
  const first = entry === undefined ? undefined : evidenceRefs(entry.verses, locale)[0];
  if (topic === undefined || first === undefined) return undefined;
  const [path, hash = ''] = first.href.split('#');
  return `${path}?topic=${topic.id}${hash === '' ? '' : `#${hash}`}`;
};
const groupById = new Map(GROUPS.map((group) => [group.id, group]));
/** The chips and table columns, grouped in the order of the timeline. */
const chipGroups = GROUPS.map((group) => ({ group, churches: ordered.filter((church) => church.group === group.id) }));

/** What the page script needs: the text of the current language only. */
const data = {
  ui: {
    reason: copy.panel.reason,
    reasonTrunk: copy.panel.reasonTrunk,
    leavesFrom: copy.panel.leavesFrom,
    addToCompare: copy.panel.addToCompare,
    removeFromCompare: copy.panel.removeFromCompare,
    kindNote: copy.kindNote,
    vsCoptic: copy.panel.vsCoptic,
    vsSame: copy.panel.vsSame,
    vsDiffer: copy.panel.vsDiffer,
    vsCount: copy.panel.vsCount,
    common: copy.compare.common,
    differs: copy.compare.differs,
    summary: copy.compare.summary,
  },
  groups: GROUPS.map((group) => ({ id: group.id, hue: group.hue, name: group.name[locale], note: group.note[locale] })),
  churches: ordered.map((church) => ({
    id: church.id,
    group: church.group,
    parent: church.parent,
    hue: church.hue,
    kind: church.kind,
    name: church.name[locale],
    short: church.short[locale],
    when: church.when[locale],
    summary: church.summary[locale],
    reason: church.reason[locale],
    changes: church.changes[locale],
    coptic: church.coptic[locale],
    vs: church.parent === null ? null : versus(church.id),
  })),
};

const axisLabelRow = (index: number): number => layout.axisY + 18 + (index % 3) * 32;
---

<Base locale={locale} title={copy.title} description={copy.metaDescription}>
  <div class="page-stage">

    <section class="intro">
      <div class="wrap">
        <h1>{copy.title}</h1>
        <p class="lede">{copy.lede}</p>
      </div>
    </section>

    <section class="timeline-section" data-church-history>
      <div class="wrap">
        <p class="hint">{copy.hint}</p>
        <p class="scroll-hint">{copy.scrollHint}</p>
        <div class="scroller">
          <div class="stage" data-stage>
            <svg class="timeline" viewBox={`0 0 ${layout.width} ${layout.height}`} role="group" aria-label={copy.timelineLabel}>
              <g class="grid" aria-hidden="true">
                {
                  layout.ticks.map((tick) => (
                    <line x1={tick.x} x2={tick.x} y1={DEFAULT_LAYOUT.top - 18} y2={layout.axisY} />
                  ))
                }
                <line class="axis" x1={DEFAULT_LAYOUT.left} x2={DEFAULT_LAYOUT.left + DEFAULT_LAYOUT.plotWidth} y1={layout.axisY} y2={layout.axisY} />
                {
                  EVENTS.map((event, index) => {
                    const x = layout.ticks[index]!.x;
                    return (
                      <g>
                        <text class="axis-year" x={x} y={axisLabelRow(index)} text-anchor="middle">{event.year}</text>
                        <text class="axis-event" x={x} y={axisLabelRow(index) + 13} text-anchor="middle">{event.label[locale]}</text>
                      </g>
                    );
                  })
                }
              </g>
              <g class="bands" aria-hidden="true">
                {
                  layout.bands.map((band) => {
                    const group = groupById.get(band.group as (typeof GROUPS)[number]['id'])!;
                    return (
                      <g class="band" style={`--gh:${group.hue}`}>
                        <rect class="band-fill" x="6" y={band.y0} width={layout.width - 12} height={band.y1 - band.y0} rx="10" />
                        <rect class="band-edge" x="6" y={band.y0} width="4" height={band.y1 - band.y0} rx="2" />
                      </g>
                    );
                  })
                }
              </g>
              <g class="threads">
                {
                  ordered.map((church) => {
                    const thread = threads.get(church.id)!;
                    const parent = church.parent === null ? null : threads.get(church.parent)!;
                    return (
                      <g
                        class={`thread${church.parent === null ? ' trunk' : ''}`}
                        data-id={church.id}
                        data-kind={church.kind}
                        style={`--h:${church.hue}`}
                        role="button"
                        tabindex="0"
                        aria-pressed="false"
                        aria-haspopup="dialog"
                        aria-label={`${church.name[locale]}, ${church.when[locale]}`}
                      >
                        <path class="halo" d={thread.path} />
                        <path class="line" d={thread.path} />
                        <path class="hit" d={thread.path} />
                        {parent !== null && <circle class="dot" cx={thread.branchX} cy={parent.y} r="4.5" />}
                        <text class="label" x={thread.labelX} y={thread.labelY - 2}>{church.short[locale]}</text>
                        <text class="when" x={thread.labelX} y={thread.labelY + 13}>{church.year}</text>
                      </g>
                    );
                  })
                }
              </g>
              <g class="band-titles" aria-hidden="true">
                {
                  layout.bands.map((band) => {
                    const group = groupById.get(band.group as (typeof GROUPS)[number]['id'])!;
                    return (
                      <text class="band-title" style={`--gh:${group.hue}`} x="20" y={band.y0 + 17}>{group.name[locale]}</text>
                    );
                  })
                }
              </g>
            </svg>

            <article class="popup" role="dialog" aria-labelledby="ch-popup-title" data-popup hidden>
              <div class="popup-top">
                <p class="eyebrow"><span class="eyebrow-dash" aria-hidden="true"></span><span data-kind-note></span></p>
                <button type="button" class="close" data-close aria-label={copy.panel.close}>✕</button>
              </div>
              <h2 id="ch-popup-title" data-name></h2>
              <p class="when-line" data-when></p>
              <p class="group-line"><span class="group-swatch" aria-hidden="true"></span><span data-group></span></p>
              <p class="summary" data-summary></p>
              <p class="leaves" data-leaves hidden></p>
              <h3 data-reason-heading></h3>
              <p data-reason></p>
              <h3>{copy.panel.changes}</h3>
              <ul class="changes" data-changes></ul>
              <div class="vs" data-vs hidden>
                <h3 data-vs-heading></h3>
                <p class="vs-count" data-vs-count></p>
                <h4 data-vs-differ-heading></h4>
                <ul class="vs-list" data-vs-differ></ul>
                <h4 data-vs-same-heading></h4>
                <p class="vs-same" data-vs-same></p>
              </div>
              <div class="coptic">
                <h3>{copy.panel.coptic}</h3>
                <p data-coptic></p>
              </div>
              <button type="button" class="compare-toggle" data-compare-toggle></button>
              <p class="draft">{copy.panel.draft}</p>
            </article>
          </div>
        </div>
        <p class="trunk-note">{copy.trunkNote}</p>
      </div>
    </section>

    <section class="compare-section" aria-labelledby="compare-heading">
      <div class="wrap">
        <h2 id="compare-heading">{copy.compare.heading}</h2>
        <p class="compare-intro">{copy.compare.intro}</p>
        <div class="chips" role="group" aria-label={copy.compare.pick}>
          {
            chipGroups.map(({ group, churches }) => (
              <div class="chip-group" style={`--gh:${group.hue}`} role="group" aria-label={group.name[locale]}>
                <p class="chip-group-title" title={group.note[locale]}>{group.name[locale]}</p>
                <div class="chip-row">
                  {
                    churches.map((church) => (
                      <button type="button" class="chip" data-chip={church.id} aria-pressed="false" style={`--h:${church.hue}`}>
                        <span class={`chip-dot${church.parent === null ? ' trunk' : ''}`} aria-hidden="true"></span>
                        {church.short[locale]}
                      </button>
                    ))
                  }
                </div>
              </div>
            ))
          }
          <button type="button" class="clear" data-clear hidden>{copy.compare.clear}</button>
        </div>
        <p class="compare-empty" data-empty>{copy.compare.empty}</p>
        <div class="compare-tools" data-tools hidden>
          <p class="compare-summary" data-compare-summary></p>
          <label class="only-differences"><input type="checkbox" data-diff-only /> {copy.compare.onlyDifferences}</label>
        </div>
        <div class="table-scroll" data-table-wrap hidden>
          <table class="compare">
            <thead>
              <tr>
                <th scope="col" class="corner">{copy.compare.church}</th>
                {
                  ordered.map((church) => (
                    <th scope="col" data-col={church.id} style={`--h:${church.hue}`} class={church.parent === null ? 'trunk' : ''}>
                      <span class="col-group" style={`--gh:${groupById.get(church.group)!.hue}`}>{groupById.get(church.group)!.name[locale]}</span>
                      <span class="col-name"><span class="col-dot" aria-hidden="true"></span>{church.short[locale]}</span>
                    </th>
                  ))
                }
              </tr>
            </thead>
            <tbody>
              {
                COMPARE_GROUPS.map((group) => (
                  <>
                    <tr class="group-row">
                      <th scope="colgroup" colspan="99">{group.label[locale]}</th>
                    </tr>
                    {
                      COMPARE_POINTS.filter((point) => point.group === group.id).map((point) => (
                        <tr class="point-row" data-point={point.id}>
                          <th scope="row">
                            <span class="point-label">{point.label[locale]}</span>
                            <span class="row-status" data-status></span>
                            {evidenceHref(point.id) !== undefined && <a class="ev-link" href={evidenceHref(point.id)} data-evidence={point.id} data-title={point.label[locale]}>{copy.compare.evidence}</a>}
                          </th>
                          {
                            ordered.map((church) => {
                              const positionId = POSITIONS[church.id]![point.id as keyof (typeof POSITIONS)[string]];
                              const index = point.positions.findIndex((position) => position.id === positionId);
                              return (
                                <td data-col={church.id} data-pos={positionId} style={`--pt:${(index * 67 + 20) % 360}`}>
                                  {pieces(positionText(point.id, positionId!)).map(({ piece, bold }) => (bold ? <strong>{piece}</strong> : piece))}
                                </td>
                              );
                            })
                          }
                        </tr>
                      ))
                    }
                  </>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="page-note">{copy.note}</p>
        <p class="back"><a href={localePath(locale)}>{strings.nav.home}</a></p>
      </div>
    </section>
  </div>

  <div class="ev-backdrop" data-ev-backdrop hidden></div>
  <section class="ev-dialog" role="dialog" aria-modal="true" aria-labelledby="ev-title" data-ev-dialog hidden>
    <div class="ev-top">
      <h2 id="ev-title" data-ev-title></h2>
      <button type="button" class="close" data-ev-close aria-label={copy.compare.evClose}>✕</button>
    </div>
    <p class="ev-status" data-ev-status hidden></p>
    <div data-ev-body hidden>
      <p class="ev-claim" data-ev-claim></p>
      <h3>{copy.compare.evVerses}</h3>
      <div class="ev-passages" data-ev-passages></div>
      <div data-ev-witness-block>
        <h3>{copy.compare.evWitnesses}</h3>
        <ul class="ev-witnesses" data-ev-witnesses></ul>
      </div>
    </div>
    <p class="ev-draft">{copy.compare.evDraft}</p>
    <a class="ev-open" href="#" data-ev-open>{copy.compare.evOpen}</a>
  </section>

  <script type="application/json" id="church-history-data" set:html={JSON.stringify(data)} />
  <script type="application/json" id="church-history-ev" set:html={JSON.stringify({ loading: copy.compare.evLoading, failed: copy.compare.evFailed })} />
</Base>

<script>
  interface ChurchData {
    id: string;
    group: string;
    parent: string | null;
    hue: number;
    kind: 'division' | 'communion' | 'daughter';
    name: string;
    short: string;
    when: string;
    summary: string;
    reason: string;
    changes: string[];
    coptic: string;
    vs: { same: string[]; differ: { label: string; text: string }[] } | null;
  }
  interface Data {
    ui: {
      reason: string;
      reasonTrunk: string;
      leavesFrom: string;
      addToCompare: string;
      removeFromCompare: string;
      kindNote: Record<ChurchData['kind'], string>;
      vsCoptic: string;
      vsSame: string;
      vsDiffer: string;
      vsCount: string;
      common: string;
      differs: string;
      summary: string;
    };
    groups: { id: string; hue: number; name: string; note: string }[];
    churches: ChurchData[];
  }

  const root = document.querySelector<HTMLElement>('[data-church-history]');
  const dataEl = document.getElementById('church-history-data');
  if (root && dataEl) init(root, JSON.parse(dataEl.textContent ?? '{}') as Data);
  initEvidence();

  interface EvidencePoint {
    claim: string;
    passages: { label: string; href: string; verses: { n: string; text: string }[] }[];
    witnesses: { title: string; when: string; note?: string }[];
  }

  /** The window that shows the verses and early witnesses of one point, without leaving the page. */
  function initEvidence(): void {
    const dialog = document.querySelector<HTMLElement>('[data-ev-dialog]');
    const backdrop = document.querySelector<HTMLElement>('[data-ev-backdrop]');
    const textEl = document.getElementById('church-history-ev');
    if (!dialog || !backdrop || !textEl) return;
    const words = JSON.parse(textEl.textContent ?? '{}') as { loading: string; failed: string };
    const part = <T extends HTMLElement>(name: string): T => dialog.querySelector<T>(`[data-ev-${name}]`)!;
    const title = part('title');
    const status = part('status');
    const body = part('body');
    const claim = part('claim');
    const passages = part('passages');
    const witnessBlock = part('witness-block');
    const witnesses = part('witnesses');
    const openLink = part<HTMLAnchorElement>('open');
    const closeButton = part<HTMLButtonElement>('close');

    let loaded: Record<string, EvidencePoint> | null = null;
    let loading: Promise<Record<string, EvidencePoint>> | null = null;
    let returnTo: HTMLElement | null = null;

    const load = (): Promise<Record<string, EvidencePoint>> => {
      if (loaded !== null) return Promise.resolve(loaded);
      loading ??= fetch(`/${document.documentElement.lang}/coptic-evidence.json`)
        .then((response) => {
          if (!response.ok) throw new Error(String(response.status));
          return response.json() as Promise<{ points: Record<string, EvidencePoint> }>;
        })
        .then((data) => (loaded = data.points))
        .catch((error: unknown) => {
          loading = null;
          throw error;
        });
      return loading;
    };

    const close = (): void => {
      dialog.hidden = true;
      backdrop.hidden = true;
      document.documentElement.classList.remove('ev-open');
      returnTo?.focus({ preventScroll: true });
    };

    const render = (point: EvidencePoint): void => {
      claim.textContent = point.claim;
      passages.replaceChildren(
        ...point.passages.map((passage) => {
          const block = document.createElement('section');
          block.className = 'ev-passage';
          const heading = document.createElement('a');
          heading.className = 'ev-ref';
          heading.href = passage.href;
          heading.textContent = passage.label;
          block.append(heading);
          const base = passage.href.split('#')[0]!;
          for (const verse of passage.verses) {
            const line = document.createElement('p');
            line.className = 'ev-verse';
            const number = document.createElement('a');
            number.className = 'ev-n';
            number.href = verse.n.includes(':') ? passage.href : `${base}#v${verse.n}`;
            number.textContent = verse.n;
            line.append(number, ' ', verse.text);
            block.append(line);
          }
          return block;
        }),
      );
      witnessBlock.hidden = point.witnesses.length === 0;
      witnesses.replaceChildren(
        ...point.witnesses.map((witness) => {
          const item = document.createElement('li');
          const name = document.createElement('strong');
          name.textContent = witness.title;
          const when = document.createElement('span');
          when.textContent = witness.when;
          item.append(name, when);
          if (witness.note !== undefined) {
            const note = document.createElement('span');
            note.textContent = witness.note;
            item.append(note);
          }
          return item;
        }),
      );
    };

    const open = (link: HTMLAnchorElement): void => {
      returnTo = link;
      title.textContent = link.dataset['title'] ?? '';
      openLink.href = link.href;
      status.textContent = words.loading;
      status.hidden = false;
      body.hidden = true;
      dialog.hidden = false;
      backdrop.hidden = false;
      document.documentElement.classList.add('ev-open');
      closeButton.focus({ preventScroll: true });
      load()
        .then((points) => {
          const point = points[link.dataset['evidence'] ?? ''];
          if (point === undefined) throw new Error('no evidence for this point');
          render(point);
          status.hidden = true;
          body.hidden = false;
          dialog.scrollTop = 0;
        })
        .catch(() => {
          status.textContent = words.failed;
        });
    };

    document.addEventListener('click', (event) => {
      const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('a[data-evidence]');
      if (link === null || event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
      event.preventDefault();
      open(link);
    });
    closeButton.addEventListener('click', close);
    backdrop.addEventListener('click', close);
    document.addEventListener(
      'keydown',
      (event) => {
        if (dialog.hidden) return;
        if (event.key === 'Escape') {
          event.stopImmediatePropagation();
          close();
        } else if (event.key === 'Tab') {
          const focusable = [...dialog.querySelectorAll<HTMLElement>('a[href], button')].filter((el) => !el.closest('[hidden]'));
          if (focusable.length === 0) return;
          const first = focusable[0]!;
          const last = focusable[focusable.length - 1]!;
          if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first.focus();
          }
        }
      },
      true,
    );
  }

  function init(root: HTMLElement, data: Data): void {
    const churches = data.churches;
    const byId = new Map(churches.map((church) => [church.id, church]));
    const q = <T extends Element>(selector: string, scope: ParentNode = document): T => {
      const found = scope.querySelector<T>(selector);
      if (!found) throw new Error(`church-history: missing ${selector}`);
      return found;
    };

    const stage = q<HTMLElement>('[data-stage]', root);
    const svg = q<SVGSVGElement>('svg.timeline', root);
    const threadEls = new Map(
      [...svg.querySelectorAll<SVGGElement>('.thread')].map((el) => [el.dataset['id'] ?? '', el] as const),
    );
    const popup = {
      el: q<HTMLElement>('[data-popup]', root),
      kind: q<HTMLElement>('[data-kind-note]', root),
      name: q<HTMLElement>('[data-name]', root),
      when: q<HTMLElement>('[data-when]', root),
      group: q<HTMLElement>('[data-group]', root),
      summary: q<HTMLElement>('[data-summary]', root),
      leaves: q<HTMLElement>('[data-leaves]', root),
      reasonHeading: q<HTMLElement>('[data-reason-heading]', root),
      reason: q<HTMLElement>('[data-reason]', root),
      changes: q<HTMLElement>('[data-changes]', root),
      coptic: q<HTMLElement>('[data-coptic]', root),
      toggle: q<HTMLButtonElement>('[data-compare-toggle]', root),
      vs: q<HTMLElement>('[data-vs]', root),
      vsHeading: q<HTMLElement>('[data-vs-heading]', root),
      vsCount: q<HTMLElement>('[data-vs-count]', root),
      vsDifferHeading: q<HTMLElement>('[data-vs-differ-heading]', root),
      vsDiffer: q<HTMLElement>('[data-vs-differ]', root),
      vsSameHeading: q<HTMLElement>('[data-vs-same-heading]', root),
      vsSame: q<HTMLElement>('[data-vs-same]', root),
      close: q<HTMLButtonElement>('[data-close]', root),
    };
    const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-chip]')];
    const clearButton = q<HTMLButtonElement>('[data-clear]');
    const empty = q<HTMLElement>('[data-empty]');
    const tableWrap = q<HTMLElement>('[data-table-wrap]');
    const columns = [...document.querySelectorAll<HTMLElement>('[data-col]')];
    const tools = q<HTMLElement>('[data-tools]');
    const summary = q<HTMLElement>("[data-compare-summary]");
    const diffOnly = q<HTMLInputElement>('[data-diff-only]');
    const pointRows = [...document.querySelectorAll<HTMLTableRowElement>('tr[data-point]')];
    const groupRows = [...document.querySelectorAll<HTMLTableRowElement>('tr.group-row')];

    /** Text with **bold** marks, as nodes (so the words that differ stand out). */
    const boldNodes = (text: string): Node[] =>
      text.split('**').map((piece, index) => {
        if (index % 2 === 0) return document.createTextNode(piece);
        const strong = document.createElement('strong');
        strong.textContent = piece;
        return strong;
      });

    let selected: string | null = null;
    const compared = new Set<string>();

    const ancestors = (id: string): string[] => {
      const chain: string[] = [];
      for (let current = byId.get(id); current; current = current.parent ? byId.get(current.parent) : undefined) chain.push(current.id);
      return chain;
    };
    const below = (id: string): string[] => {
      const out: string[] = [];
      const queue = [id];
      while (queue.length > 0) {
        const head = queue.shift();
        for (const church of churches) {
          if (church.parent === head) {
            out.push(church.id);
            queue.push(church.id);
          }
        }
      }
      return out;
    };

    function paintTimeline(): void {
      const family = selected ? new Set([...ancestors(selected), ...below(selected)]) : null;
      svg.classList.toggle('has-selection', family !== null);
      for (const [id, el] of threadEls) {
        el.classList.toggle('selected', id === selected);
        el.classList.toggle('related', family !== null && id !== selected && family.has(id));
        el.classList.toggle('compared', compared.has(id));
        el.setAttribute('aria-pressed', String(id === selected));
      }
    }

    function fillPopup(church: ChurchData): void {
      popup.el.style.setProperty('--h', String(church.hue));
      popup.el.classList.toggle('is-trunk', church.parent === null);
      popup.kind.textContent = church.parent === null ? data.ui.reasonTrunk : data.ui.kindNote[church.kind];
      popup.name.textContent = church.name;
      popup.when.textContent = church.when;
      const group = data.groups.find((g) => g.id === church.group);
      popup.group.textContent = group?.name ?? '';
      popup.el.style.setProperty('--gh', String(group?.hue ?? 0));
      popup.summary.textContent = church.summary;
      const parent = church.parent ? byId.get(church.parent) : undefined;
      popup.leaves.hidden = parent === undefined;
      popup.leaves.textContent = parent ? `${data.ui.leavesFrom}: ${parent.short}` : '';
      popup.reasonHeading.textContent = church.parent === null ? data.ui.reasonTrunk : data.ui.reason;
      popup.reason.textContent = church.reason;
      popup.changes.replaceChildren(
        ...church.changes.map((text) => {
          const li = document.createElement('li');
          li.textContent = text;
          return li;
        }),
      );
      popup.coptic.textContent = church.coptic;
      popup.vs.hidden = church.vs === null;
      if (church.vs !== null) {
        popup.vsHeading.textContent = data.ui.vsCoptic;
        popup.vsCount.textContent = data.ui.vsCount.replace('{same}', String(church.vs.same.length)).replace('{differ}', String(church.vs.differ.length));
        popup.vsDifferHeading.textContent = data.ui.vsDiffer;
        popup.vsDiffer.replaceChildren(
          ...church.vs.differ.map((item) => {
            const li = document.createElement('li');
            const label = document.createElement('span');
            label.className = 'vs-label';
            label.textContent = item.label;
            const text = document.createElement('span');
            text.append(...boldNodes(item.text));
            li.append(label, text);
            return li;
          }),
        );
        popup.vsSameHeading.textContent = data.ui.vsSame;
        popup.vsSame.textContent = church.vs.same.join(' · ');
      }
      paintToggle();
    }

    function paintToggle(): void {
      if (!selected) return;
      const on = compared.has(selected);
      popup.toggle.textContent = on ? data.ui.removeFromCompare : data.ui.addToCompare;
      popup.toggle.setAttribute('aria-pressed', String(on));
    }

    /** Puts the popup beside the point that was clicked, inside the timeline; on a phone it is a sheet at the bottom. */
    function placePopup(point: { x: number; y: number }): void {
      if (!matchMedia('(min-width: 48rem)').matches) {
        popup.el.style.left = '';
        popup.el.style.top = '';
        return;
      }
      const area = stage.getBoundingClientRect();
      const width = popup.el.offsetWidth;
      const height = popup.el.offsetHeight;
      let left = point.x - area.left + 20;
      if (left + width > area.width) left = point.x - area.left - width - 20;
      left = Math.min(Math.max(left, 0), Math.max(0, area.width - width));
      const top = Math.min(Math.max(point.y - area.top - 36, 0), Math.max(0, area.height - height));
      popup.el.style.left = `${left}px`;
      popup.el.style.top = `${top}px`;
    }

    function paintCompare(): void {
      for (const chip of chips) chip.setAttribute('aria-pressed', String(compared.has(chip.dataset['chip'] ?? '')));
      for (const el of columns) el.hidden = !compared.has(el.dataset['col'] ?? '');
      const enough = compared.size >= 2;
      tableWrap.hidden = !enough;
      tools.hidden = !enough;
      empty.hidden = enough;
      if (enough) paintRows();
      clearButton.hidden = compared.size === 0;
      paintToggle();
    }

    /** For every point of faith: is it the same in all the churches shown, or does it differ? */
    function paintRows(): void {
      let common = 0;
      let differ = 0;
      const visibleGroups = new Set<Element>();
      pointRows.forEach((row) => {
        const positions = new Set<string>();
        for (const cell of row.querySelectorAll<HTMLElement>('td[data-col]')) if (!cell.hidden) positions.add(cell.dataset['pos'] ?? '');
        const same = positions.size === 1;
        row.classList.toggle('common', same);
        row.classList.toggle('differs', !same);
        const status = row.querySelector<HTMLElement>('[data-status]');
        if (status) status.textContent = same ? data.ui.common : data.ui.differs;
        if (same) common += 1;
        else differ += 1;
        row.hidden = diffOnly.checked && same;
        if (!row.hidden) {
          let group = row.previousElementSibling;
          while (group && !group.classList.contains('group-row')) group = group.previousElementSibling;
          if (group) visibleGroups.add(group);
        }
      });
      for (const group of groupRows) group.hidden = !visibleGroups.has(group);
      summary.textContent = data.ui.summary.replace('{common}', String(common)).replace('{differ}', String(differ));
    }

    function syncUrl(): void {
      const params = new URLSearchParams();
      if (selected) params.set('church', selected);
      if (compared.size > 0) params.set('compare', [...compared].join(','));
      const query = params.toString();
      history.replaceState(null, '', query ? `?${query}` : location.pathname);
    }

    function open(id: string, point?: { x: number; y: number }, moveFocus = false): void {
      const church = byId.get(id);
      const el = threadEls.get(id);
      if (!church || !el) return;
      selected = id;
      fillPopup(church);
      popup.el.hidden = false;
      const box = el.querySelector('.label')?.getBoundingClientRect() ?? el.getBoundingClientRect();
      placePopup(point ?? { x: box.left, y: box.top + box.height / 2 });
      paintTimeline();
      syncUrl();
      if (moveFocus) popup.close.focus({ preventScroll: true });
    }

    function close(returnFocus = true): void {
      const previous = selected;
      selected = null;
      popup.el.hidden = true;
      paintTimeline();
      syncUrl();
      if (returnFocus && previous) threadEls.get(previous)?.focus({ preventScroll: true });
    }

    function toggleCompare(id: string): void {
      if (compared.has(id)) compared.delete(id);
      else compared.add(id);
      paintTimeline();
      paintCompare();
      syncUrl();
    }

    const order = churches.map((church) => church.id);

    for (const [id, el] of threadEls) {
      el.addEventListener('click', (event) => open(id, { x: event.clientX, y: event.clientY }));
      el.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          open(id, undefined, true);
        } else if (event.key === 'ArrowDown' || event.key === 'ArrowRight') {
          event.preventDefault();
          const next = order[order.indexOf(id) + 1];
          if (next) threadEls.get(next)?.focus();
        } else if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') {
          event.preventDefault();
          const previous = order[order.indexOf(id) - 1];
          if (previous) threadEls.get(previous)?.focus();
        }
      });
    }
    popup.close.addEventListener('click', () => close());
    popup.toggle.addEventListener('click', () => {
      if (selected) toggleCompare(selected);
    });
    diffOnly.addEventListener('change', paintRows);
    for (const chip of chips) chip.addEventListener('click', () => toggleCompare(chip.dataset['chip'] ?? ''));
    clearButton.addEventListener('click', () => {
      compared.clear();
      paintTimeline();
      paintCompare();
      syncUrl();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && selected) close();
    });

    const params = new URLSearchParams(location.search);
    for (const id of (params.get('compare') ?? '').split(',')) if (byId.has(id)) compared.add(id);
    paintCompare();
    const first = params.get('church');
    if (first && byId.has(first)) open(first);
  }
</script>

