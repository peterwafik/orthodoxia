---
/**
 * The Holy Mass journey: the Divine Liturgy stop by stop. 31 line drawings (public/holy-mass-bg, timeline in
 * lib/holy-mass/backdrop.ts) lie softly behind the page and dissolve into one another as you scroll. In front of
 * it each stop is a short chat: what the priest, the deacon and the people say, then the steps in the
 * altar and the meaning behind. The list of stops hides behind a hamburger button.
 *
 * ONE language at a time: /en/ shows English only and /ar/ shows Arabic only (the header's language link
 * switches). One page per liturgy (/en/holy-mass/basil/, /gregory/, /cyril/), chosen on the page before. The player is lib/holy-mass/backdrop-player.ts, the stops
 * in data/holy-mass.ts, the prayer texts in content/liturgy/ (loaded per liturgy).
 */
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/holy-mass/Icon.astro';
import { LOCALES, localePath, t, type Locale } from '../../../i18n/index.ts';
import { CHAPTERS, LITURGIES, STOPS, stopHash } from '../../../data/holy-mass.ts';

export function getStaticPaths() {
  return LOCALES.flatMap((lang) => LITURGIES.map((liturgy) => ({ params: { lang, liturgy: liturgy.id } })));
}

const locale = Astro.params.lang as Locale;
const liturgy = LITURGIES.find((candidate) => candidate.id === Astro.params.liturgy)!;

const UI = {
  en: {
    title: 'Holy Mass',
    description: 'The Coptic Orthodox Divine Liturgy as a journey: follow the prayers from the earthly church toward the heavenly worship, stop by stop.',
    heading: 'A journey into heaven',
    sub: 'The Coptic Orthodox Divine Liturgy: from earthly worship to heavenly communion',
    begin: 'Scroll to begin',
    journey: 'The Liturgy journey',
    menu: 'The journey: all stops',
    stopsCount: (n: number) => `${n} stops`,
    stopOf: (n: number, total: number) => `Stop ${n} of ${total}`,
    previous: 'Previous',
    next: 'Next',
    otherLiturgy: 'Choose another liturgy',
    priest: 'Priest',
    deacon: 'Deacon',
    people: 'People',
    layersLabel: 'What to show',
    steps: 'Steps',
    meaningLayer: 'Meaning',
    stepsTitle: 'Steps happening in the altar',
    meaningTitle: 'Meaning behind',
    draftTag: 'Draft',
    hiddenAll: 'Everything is hidden. Use the buttons below to show the priest, the deacon, the people, the steps or the meaning.',
    textPending: 'The text of this prayer has not been added yet.',
    notInLanguage: 'Part of this text is not yet available in English.',
    textSource: 'Text',
    seeSources: 'see the Sources page',
    textSize: 'Text size',
    smaller: 'Smaller text',
    larger: 'Larger text',
    varies: (liturgy: string) => `This part differs in each of the three liturgies. The text for ${liturgy} will be added from an authorized translation.`,
    resume: (n: number) => `Resume at stop ${n}`,
    options: 'Options',
    close: 'Close',
    disclaimer: 'The artwork is a symbolic visual meditation inspired by Coptic Orthodox worship, not a literal picture of heaven.',
    viewportLabel: 'Drawings of the Divine Liturgy that change as you read each prayer.',
    imageNote: 'The drawings behind the page are a symbolic illustration inspired by the Coptic liturgy that awaits review by clergy; they are not official icons.',
    meaningCredit: 'The “Meaning behind” notes summarise, in the site’s own words, two books: The Spirituality of the Rites of the Holy Liturgy in the Coptic Orthodox Church (introduction by Bishop Mettaous) and the lecture notes Analysis and Explanation of the Consecration Prayers in the Three Liturgies by Michael Mina (Clerical College, Port Said). They have not been reviewed by clergy.',
  },
  ar: {
    title: 'القداس الإلهي',
    description: 'القداس الإلهي القبطي الأرثوذكسي كرحلة: تتبّع الصلوات من الكنيسة الأرضية نحو العبادة السماوية، محطة بعد محطة.',
    heading: 'رحلة إلى السماء',
    sub: 'القداس الإلهي القبطي الأرثوذكسي: من العبادة الأرضية إلى الشركة السماوية',
    begin: 'مرّر للأسفل لتبدأ',
    journey: 'رحلة القداس',
    menu: 'الرحلة: كل المحطات',
    stopsCount: (n: number) => `${n} محطة`,
    stopOf: (n: number, total: number) => `المحطة ${n} من ${total}`,
    previous: 'السابق',
    next: 'التالي',
    otherLiturgy: 'اختر قداسًا آخر',
    priest: 'الكاهن',
    deacon: 'الشماس',
    people: 'الشعب',
    layersLabel: 'ما الذي تريد إظهاره',
    steps: 'الخطوات',
    meaningLayer: 'المعنى',
    stepsTitle: 'ما يحدث في المذبح',
    meaningTitle: 'المعنى وراء ذلك',
    draftTag: 'مسودة',
    hiddenAll: 'كل شيء مخفي. استخدم الأزرار في الأسفل لإظهار الكاهن أو الشماس أو الشعب أو الخطوات أو المعنى.',
    textPending: 'لم يُضَف نص هذه الصلاة بعد.',
    notInLanguage: 'جزء من هذا النص غير متاح بالعربية بعد.',
    textSource: 'النص',
    seeSources: 'انظر صفحة المصادر',
    textSize: 'حجم النص',
    smaller: 'نص أصغر',
    larger: 'نص أكبر',
    varies: (liturgy: string) => `يختلف هذا الجزء في كل من القداسات الثلاثة. سيُضاف نص ${liturgy} من ترجمة معتمدة.`,
    resume: (n: number) => `تابع من المحطة ${n}`,
    options: 'خيارات',
    close: 'إغلاق',
    disclaimer: 'اللوحة تأمل بصري رمزي مستوحى من العبادة القبطية الأرثوذكسية، وليست صورة حرفية للسماء.',
    viewportLabel: 'رسومات للقداس الإلهي تتغير مع كل صلاة تقرؤها.',
    imageNote: 'الرسومات خلف الصفحة توضيح رمزي مستوحى من القداس القبطي ينتظر مراجعة الآباء الكهنة؛ وليست أيقونات رسمية.',
    meaningCredit: 'ملاحظات «المعنى وراء» ملخَّصة بكلمات الموقع من كتابين: «روحانية طقوس القداس الإلهي في الكنيسة القبطية الأرثوذكسية» (مقدمة الأنبا متاؤس)، ومذكرات محاضرات «تحليل وشرح صلوات التقديس بالقداسات الثلاثة» للأستاذ ميخائيل مينا (الكلية الإكليريكية، فرع بورسعيد). ولم يراجعها الآباء الكهنة بعد.',
  },
} as const;
const ui = UI[locale];

const total = STOPS.length;
const stopsByChapter = CHAPTERS.map((chapter) => ({ chapter, stops: STOPS.filter((stop) => stop.chapter === chapter.id) }));

const SPEAKERS = ['priest', 'deacon', 'people'] as const;
/** The speakers who have a draft summary at a stop. */
function speakersOf(stop: (typeof STOPS)[number]) {
  return SPEAKERS.filter((role) => stop.says[role] !== undefined);
}
const clientStops = STOPS.map((stop) => ({ n: stop.n, hash: stopHash(stop), chapter: stop.chapter, speakers: speakersOf(stop) }));
---

<Base locale={locale} title={`${ui.title}: ${liturgy.title[locale]}`} description={ui.description}>
  <div class="journey" data-journey data-total={total} data-locale={locale} data-liturgy={liturgy.id} data-liturgy-name={liturgy.title[locale]}>
    <section class="stage" aria-label={ui.viewportLabel}>
      <div class="film" data-film role="img" aria-label={ui.viewportLabel}></div>
      <div class="wash" aria-hidden="true"></div>
    </section>

    <header class="topbar">
      <button type="button" class="icon-button" data-rail-open aria-controls="hm-rail" aria-expanded="false" aria-label={ui.menu} title={ui.menu}>
        <Icon name="menu" />
      </button>
      <p class="where" data-where aria-live="polite"></p>
      <button type="button" class="icon-button" data-options-toggle aria-controls="hm-options" aria-expanded="false" aria-label={ui.options} title={ui.options}>
        <Icon name="options" />
      </button>
      <div class="nav">
        <button type="button" class="icon-button step" data-prev aria-label={ui.previous} title={ui.previous}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="m14 6-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </button>
        <button type="button" class="icon-button step" data-next aria-label={ui.next} title={ui.next}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="m10 6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </button>
      </div>
      <div class="progress" aria-hidden="true"><span data-progress></span></div>
      <div class="options" id="hm-options" data-options>
        <a class="other-liturgy" href={localePath(locale, 'holy-mass')}>{ui.otherLiturgy}</a>
        <div class="sizer" role="group" aria-label={ui.textSize}>
          <button type="button" class="icon-button" dir="ltr" data-size="-1" aria-label={ui.smaller} title={ui.smaller}>A−</button>
          <button type="button" class="icon-button" dir="ltr" data-size="1" aria-label={ui.larger} title={ui.larger}>A+</button>
        </div>
      </div>
    </header>
    <p class="resume" data-resume hidden><a href="#" data-resume-link></a></p>

    <div class="panel-scroll" data-scroller tabindex="0">
      {
        STOPS.map((stop) => {
          const drafts = SPEAKERS.flatMap((role) => {
            const summary = stop.says[role];
            return summary === undefined ? [] : [{ role, text: summary[locale] }];
          });
          return (
            <article class="stop" id={`stop-${stopHash(stop)}`} data-n={stop.n} data-chapter={stop.chapter} aria-labelledby={`h-${stop.n}`}>
              {stop.n === 1 && (
                <div class="opening">
                  <p class="eyebrow">{ui.sub}</p>
                  <h1>{ui.heading}</h1>
                  <p class="begin">{ui.begin}</p>
                </div>
              )}
              <p class="chapter-label">
                {CHAPTERS[stop.chapter - 1]!.title[locale]} · {ui.stopOf(stop.n, total)}
              </p>
              <h2 id={`h-${stop.n}`}>{stop.title[locale]}</h2>

              <div class="chat">
                <div class="drafts">
                  {drafts.map((draft) => (
                    <div class={`bubble bubble-${draft.role} draft`}>
                      <p class="who">
                        <Icon name={draft.role} size={16} /> {ui[draft.role]} <span class="draft-tag">{ui.draftTag}</span>
                      </p>
                      <p class="line">{draft.text}</p>
                    </div>
                  ))}
                </div>
                <div class="script" data-script></div>
                <p class="lang-note" data-lang-note hidden>{ui.notInLanguage}</p>
                <p class="pending-note">{ui.textPending}</p>
              </div>

              <div class="asides">
                <section class="aside aside-steps">
                  <h3><Icon name="steps" size={18} /> {ui.stepsTitle}</h3>
                  <p>{stop.what[locale]}</p>
                </section>
                <section class="aside aside-meaning">
                  <h3><Icon name="meaning" size={18} /> {ui.meaningTitle}</h3>
                  {stop.meaning[locale].split('\n\n').map((paragraph) => <p>{paragraph}</p>)}
                </section>
              </div>
              <p class="all-hidden">{ui.hiddenAll}</p>

            </article>
          );
        })
      }
      <footer class="panel-foot">
        <p>{ui.disclaimer}</p>
        <p>{ui.imageNote}</p>
        <p>{ui.meaningCredit}</p>
        <p><a href={localePath(locale, 'sources')}>{t(locale).nav.sources}</a></p>
      </footer>
    </div>

    <div class="dock" role="group" aria-label={ui.layersLabel}>
      {
        (['priest', 'deacon', 'people', 'steps', 'meaning'] as const).map((layer) => (
          <button type="button" class={`layer layer-${layer}`} data-layer-toggle={layer} aria-pressed="true" title={layer === 'meaning' ? ui.meaningTitle : layer === 'steps' ? ui.stepsTitle : ui[layer]}>
            <Icon name={layer} />
            <span>{layer === 'meaning' ? ui.meaningLayer : ui[layer]}</span>
          </button>
        ))
      }
    </div>

    <div class="scrim" data-scrim hidden></div>
    <aside class="rail" id="hm-rail" data-open="false" inert aria-label={ui.journey}>
      <div class="rail-head">
        <p class="rail-title">{ui.journey}</p>
        <p class="rail-count">{ui.stopsCount(total)}</p>
        <button type="button" class="rail-close" data-rail-close>{ui.close}</button>
      </div>
      <ol class="rail-chapters">
        {
          stopsByChapter.map(({ chapter, stops }) => (
            <li>
              <details open={chapter.id === 1} data-chapter={chapter.id}>
                <summary>
                  <span class="num">{['I', 'II', 'III', 'IV', 'V'][chapter.id - 1]}</span>
                  <span class="name">{chapter.title[locale]}</span>
                  <span class="range">
                    {stops[0]!.n}–{stops.at(-1)!.n}
                  </span>
                </summary>
                <ol class="rail-stops">
                  {stops.map((stop) => (
                    <li>
                      <a href={`#${stopHash(stop)}`} data-stop={stop.n}>
                        <span class="n">{stop.n}</span>
                        <span class="t">{stop.title[locale]}</span>
                      </a>
                    </li>
                  ))}
                </ol>
              </details>
            </li>
          ))
        }
      </ol>
    </aside>
  </div>

  <script type="application/json" id="hm-stops" set:html={JSON.stringify(clientStops)}></script>
  <script type="application/json" id="hm-ui" set:html={JSON.stringify({ stopOf: ui.stopOf(0, total).replace('0', '{n}'), varies: ui.varies('{liturgy}'), resume: ui.resume(0).replace('0', '{n}'), roles: { rubric: ui.steps, priest: ui.priest, deacon: ui.deacon, people: ui.people }, source: ui.textSource, seeSources: ui.seeSources, sourcesHref: localePath(locale, 'sources') })}></script>
</Base>

<script>
  import { createBackdrop } from '../../../lib/holy-mass/backdrop-player.ts';
  import { LAYERS, LAYERS_KEY, parseLayers, serializeLayers, toggleLayer, type Layer, type LayerState } from '../../../lib/holy-mass/layers.ts';
  import { loadLiturgy } from '../../../lib/holy-mass/load.ts';
  import { parseReading, READING_KEY, serializeReading, stepSize, type Reading } from '../../../lib/holy-mass/reading.ts';
  import { creditFor, hasRubric, scriptItems } from '../../../lib/holy-mass/script-view.ts';
  import type { LiturgyJson } from '../../../lib/liturgy/build-core.ts';
  import type { LiturgyId } from '../../../lib/liturgy/resolve.ts';

  interface ClientStop {
    n: number;
    hash: string;
    chapter: number;
    speakers: string[];
  }

  const root = document.querySelector<HTMLElement>('[data-journey]');
  if (root !== null) {
    const stops = JSON.parse(document.getElementById('hm-stops')!.textContent!) as ClientStop[];
    const text = JSON.parse(document.getElementById('hm-ui')!.textContent!) as { stopOf: string; varies: string; resume: string; roles: Record<string, string>; source: string; seeSources: string; sourcesHref: string };
    const pageLocale: 'en' | 'ar' = root.dataset['locale'] === 'ar' ? 'ar' : 'en';
    const total = stops.length;
    const filmBox = root.querySelector<HTMLElement>('[data-film]')!;
    const scroller = root.querySelector<HTMLElement>('[data-scroller]')!;
    const articles = [...scroller.querySelectorAll<HTMLElement>('.stop')];
    const railLinks = [...root.querySelectorAll<HTMLAnchorElement>('[data-stop]')];
    const where = root.querySelector<HTMLElement>('[data-where]')!;
    const progress = root.querySelector<HTMLElement>('[data-progress]')!;
    const rail = root.querySelector<HTMLElement>('#hm-rail')!;
    const scrim = root.querySelector<HTMLElement>('[data-scrim]')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');

    // ---- layout: fit the journey under the site header ----------------------------------------
    const header = document.querySelector<HTMLElement>('.site-header');
    const fit = () => root.style.setProperty('--hm-header', `${header?.offsetHeight ?? 0}px`);
    fit();
    if (header !== null && typeof ResizeObserver !== 'undefined') new ResizeObserver(fit).observe(header);

    // ---- the artwork: 31 drawings that dissolve into one another as the stops go by -----------------
    const film = createBackdrop({ container: filmBox, base: '/holy-mass-bg', reducedMotion: () => reduced.matches });
    film.warm();

    // ---- scroll → artwork ----------------------------------------------------------------------
    let tops: number[] = [];
    function measure() {
      tops = articles.map((article) => article.offsetTop - articles[0]!.offsetTop);
    }

    function position(): number {
      const y = scroller.scrollTop;
      if (tops.length === 0) return 0;
      let i = tops.length - 1;
      while (i > 0 && tops[i]! > y) i--;
      const next = tops[i + 1];
      if (next === undefined) return i;
      return i + Math.min(1, Math.max(0, (y - tops[i]!) / (next - tops[i]!)));
    }

    let active = -1;
    let visitedMax = 0;
    // The address and the saved place are only written once the reader has moved, and a deep link
    // is held in place while the layout settles (fonts, images) until then.
    let interacted = false;
    let anchor: number | null = null;
    const moved = () => {
      interacted = true;
      anchor = null;
    };
    for (const type of ['wheel', 'touchstart', 'pointerdown', 'keydown'] as const) scroller.addEventListener(type, moved, { passive: true });
    const initialHash = decodeURIComponent(location.hash.slice(1));
    function update() {
      const p = position();
      const nearest = Math.round(p);
      film.show(p);
      if (nearest !== active) {
        active = nearest;
        visitedMax = Math.max(visitedMax, active);
        const stop = stops[active]!;
        where.textContent = text.stopOf.replace('{n}', String(stop.n));
        dimSilent(stop);
        progress.style.inlineSize = `${((active + 1) / total) * 100}%`;
        for (const link of railLinks) {
          const n = Number(link.dataset['stop']);
          if (n === stop.n) {
            link.setAttribute('aria-current', 'step');
            link.closest('details')?.setAttribute('open', '');
          } else {
            link.removeAttribute('aria-current');
          }
          link.classList.toggle('done', n <= visitedMax && n !== stop.n);
        }
        const note = railLinks.find((link) => Number(link.dataset['stop']) === stop.n);
        // Keep the active stop in view inside the list without scrolling the whole page.
        if (note !== undefined && rail.scrollHeight > rail.clientHeight) {
          const box = rail.getBoundingClientRect();
          const at = note.getBoundingClientRect();
          if (at.top < box.top + 8 || at.bottom > box.bottom - 8) rail.scrollTop += at.top - box.top - box.height / 3;
        }
        try {
          if (interacted) {
            history.replaceState(null, '', `#${stop.hash}`);
            localStorage.setItem('orthodoxia:holy-mass', String(stop.n));
          }
        } catch {
          // Storage or history unavailable: the journey still works.
        }
      }
    }

    let scrollRequested = false;
    scroller.addEventListener(
      'scroll',
      () => {
        if (scrollRequested) return;
        scrollRequested = true;
        requestAnimationFrame(() => {
          scrollRequested = false;
          update();
        });
      },
      { passive: true },
    );

    function goTo(index: number, smooth = true) {
      if (smooth) moved();
      const clamped = Math.min(total - 1, Math.max(0, index));
      scroller.scrollTo({ top: tops[clamped] ?? 0, behavior: smooth && !reduced.matches ? 'smooth' : 'auto' });
    }

    root.querySelector('[data-next]')?.addEventListener('click', () => goTo(Math.round(position()) + 1));
    root.querySelector('[data-prev]')?.addEventListener('click', () => goTo(Math.round(position()) - 1));

    // ---- the hamburger: the list of stops slides over the film -----------------------------------
    const openButton = root.querySelector<HTMLButtonElement>('[data-rail-open]')!;
    function setRail(open: boolean) {
      rail.dataset['open'] = String(open);
      rail.inert = !open;
      scrim.hidden = !open;
      openButton.setAttribute('aria-expanded', String(open));
      if (open) rail.querySelector<HTMLElement>('[data-rail-close]')?.focus();
      else if (rail.contains(document.activeElement)) openButton.focus();
    }
    openButton.addEventListener('click', () => setRail(rail.dataset['open'] !== 'true'));
    root.querySelector('[data-rail-close]')?.addEventListener('click', () => setRail(false));
    scrim.addEventListener('click', () => {
      setRail(false);
      setOptions(false);
    });
    for (const link of railLinks) {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        goTo(Number(link.dataset['stop']) - 1);
        setRail(false);
      });
    }

    const optionsBox = root.querySelector<HTMLElement>('[data-options]')!;
    const optionsToggle = root.querySelector<HTMLButtonElement>('[data-options-toggle]')!;
    function setOptions(open: boolean) {
      optionsBox.dataset['open'] = String(open);
      optionsToggle.setAttribute('aria-expanded', String(open));
    }
    optionsToggle.addEventListener('click', () => setOptions(optionsBox.dataset['open'] !== 'true'));
    window.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      setRail(false);
      setOptions(false);
    });

    // ---- layers: what the reader chooses to see -------------------------------------------------
    const layerButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-layer-toggle]')];
    let layers: LayerState = parseLayers(null);
    try {
      layers = parseLayers(localStorage.getItem(LAYERS_KEY));
    } catch {
      // Defaults.
    }
    function applyLayers() {
      for (const button of layerButtons) {
        const layer = button.dataset['layerToggle'] as Layer;
        button.setAttribute('aria-pressed', String(layers[layer]));
        root!.classList.toggle(`no-${layer}`, !layers[layer]);
      }
      root!.classList.toggle('no-layers', LAYERS.every((layer) => !layers[layer]));
      // Hidden parts change the height of every stop.
      requestAnimationFrame(() => {
        measure();
        update();
      });
    }
    for (const button of layerButtons) {
      button.addEventListener('click', () => {
        layers = toggleLayer(layers, button.dataset['layerToggle'] as Layer);
        try {
          localStorage.setItem(LAYERS_KEY, serializeLayers(layers));
        } catch {
          // Not saved.
        }
        applyLayers();
      });
    }
    // The speakers who say nothing at the current stop are dimmed.
    function dimSilent(stop: ClientStop) {
      for (const button of layerButtons) {
        const layer = button.dataset['layerToggle']!;
        if (layer === 'priest' || layer === 'deacon' || layer === 'people') button.dataset['silent'] = String(!stop.speakers.includes(layer));
      }
    }

    // ---- the prayers: the chat of each stop -------------------------------------------------------
    let scripts: LiturgyJson | null = null;
    const liturgyId = (root.dataset['liturgy'] ?? 'basil') as LiturgyId;
    let reading: Reading = parseReading(null);
    try {
      reading = parseReading(localStorage.getItem(READING_KEY));
    } catch {
      // Defaults.
    }
    const slugOf = (stop: ClientStop) => stop.hash.replace(/^\d+-/, '');
    const roleIcon = (role: string) => layerButtons.find((button) => button.dataset['layerToggle'] === role)?.querySelector('svg') ?? null;

    function renderScripts() {
      articles.forEach((article, index) => {
        const box = article.querySelector<HTMLElement>('[data-script]')!;
        const languageNote = article.querySelector<HTMLElement>('[data-lang-note]')!;
        box.replaceChildren();
        const entry = scripts?.stops[slugOf(stops[index]!)];
        // Only the page's language is ever shown. A stop whose text is missing in it (or unusable)
        // keeps its draft summaries, and says so.
        const items = entry === undefined ? [] : scriptItems(entry.blocks, pageLocale);
        languageNote.hidden = entry === undefined || items.length > 0;
        article.classList.toggle('has-script', items.length > 0);
        article.classList.toggle('has-rubric', entry !== undefined && hasRubric(entry.blocks) && items.some((item) => item.role === 'rubric'));
        if (entry === undefined || items.length === 0) return;
        for (const item of items) {
          const element = document.createElement('div');
          const line = document.createElement('p');
          line.className = 'line';
          line.textContent = item.text;
          if (item.role === 'rubric') {
            element.className = 'rubric';
            element.append(line);
          } else {
            element.className = `bubble bubble-${item.role}`;
            const who = document.createElement('p');
            who.className = 'who';
            const icon = roleIcon(item.role)?.cloneNode(true);
            if (icon !== undefined && icon !== null) who.append(icon, ' ');
            who.append(text.roles[item.role] ?? '');
            element.append(who, line);
            if (item.note !== undefined) {
              const note = document.createElement('p');
              note.className = 'note';
              note.textContent = item.note;
              element.append(note);
            }
          }
          box.append(element);
        }
        const credit = document.createElement('p');
        credit.className = 'tiny credit';
        // The credit is in the page's language too; a source in the other language is never shown.
        const { label, url } = creditFor(entry, pageLocale);
        if (label === null) {
          credit.append(`${text.source}: `);
          const sources = document.createElement('a');
          sources.href = text.sourcesHref;
          sources.textContent = text.seeSources;
          credit.append(sources);
        } else {
          credit.append(`${text.source}: ${label}`);
          if (url !== undefined) {
            credit.append(' ');
            const link = document.createElement('a');
            link.href = url;
            link.textContent = url;
            credit.append(link);
          }
        }
        box.append(credit);
      });
      requestAnimationFrame(() => {
        measure();
        update();
      });
    }

    async function showLiturgy(id: LiturgyId) {
      scripts = await loadLiturgy(id);
      renderScripts();
    }

    // ---- the liturgy was chosen on the page before; here are the text size and the saved place ----
    for (const note of root.querySelectorAll<HTMLElement>('[data-varies]')) note.textContent = text.varies.replace('{liturgy}', root.dataset['liturgyName'] ?? '');
    void showLiturgy(liturgyId);
    let savedStop = 0;
    try {
      savedStop = Number(localStorage.getItem('orthodoxia:holy-mass') ?? '0');
    } catch {
      // Defaults.
    }
    applyLayers();
    const sizeButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-size]')];
    function applyReading() {
      root!.dataset['size'] = reading.size;
      sizeButtons[0]!.setAttribute('aria-disabled', String(reading.size === 'small'));
      sizeButtons[1]!.setAttribute('aria-disabled', String(reading.size === 'large'));
      try {
        localStorage.setItem(READING_KEY, serializeReading(reading));
      } catch {
        // Not saved.
      }
      requestAnimationFrame(() => {
        measure();
        update();
      });
    }
    for (const button of sizeButtons) {
      button.addEventListener('click', () => {
        if (button.getAttribute('aria-disabled') === 'true') return;
        reading = stepSize(reading, Number(button.dataset['size']) as -1 | 1);
        applyReading();
      });
    }
    applyReading();

    // ---- start: deep link, or offer to resume ---------------------------------------------------
    if (typeof ResizeObserver === 'undefined') window.addEventListener('resize', () => {
      measure();
      update();
    });
    reduced.addEventListener('change', update);
    measure();
    update();
    const fromHash = stops.findIndex((stop) => stop.hash === initialHash);
    if (fromHash > 0) {
      anchor = fromHash;
      goTo(fromHash, false);
    } else if (savedStop > 1 && savedStop <= total) {
      const box = root.querySelector<HTMLElement>('[data-resume]')!;
      const link = root.querySelector<HTMLAnchorElement>('[data-resume-link]')!;
      link.textContent = text.resume.replace('{n}', String(savedStop));
      box.hidden = false;
      link.addEventListener('click', (event) => {
        event.preventDefault();
        box.hidden = true;
        goTo(savedStop - 1);
      });
    }
    // Back, Forward, or a changed address moves the camera to that stop.
    window.addEventListener('hashchange', () => {
      const index = stops.findIndex((stop) => stop.hash === decodeURIComponent(location.hash.slice(1)));
      if (index >= 0 && index !== Math.round(position())) goTo(index);
    });
    // Fonts and wrapping change the page's height after load.
    const settle = () => {
      measure();
      if (anchor !== null) scroller.scrollTop = tops[anchor] ?? 0;
      update();
    };
    if (typeof ResizeObserver !== 'undefined') new ResizeObserver(settle).observe(scroller);
    void document.fonts?.ready.then(settle);
    window.addEventListener('load', settle);
    update();
  }
</script>

<style>
  .journey {
    --hm-header: 4.5rem;
    --bar: 3.9rem;
    --navy: #07172c;
    --gold: #c49a50;
    --gold-bright: #e8c67d;
    --parchment: #f7f0e3;
    --ivory: #fff9ef;
    --paper: #f5f1e6;
    --burgundy: #6b2430;
    --ink: #18243a;
    position: relative;
    block-size: calc(100dvh - var(--hm-header));
    min-block-size: 28rem;
    background: var(--paper);
    color: var(--ink);
    overflow: hidden;
  }

  /* --- the film behind everything ----------------------------------------------------------- */
  .stage {
    position: absolute;
    /* Starts under the top bar, so the whole drawing is in view below it. */
    inset: var(--bar) 0 0;
    z-index: 0;
  }

  .film {
    position: absolute;
    inset: 0;
    isolation: isolate;
    background: var(--paper);
    /* Transparent: the text stays the main thing. */
    opacity: 0.42;
  }

  /* The drawings are laid on the paper like a watermark: each one is shown whole, centred, and multiplied so
     its cream ground melts into the paper. The fade to the paper colour at its edges is part of the image file. */
  .film :global(.backdrop-image) {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
    object-position: center;
    display: block;
    pointer-events: none;
    mix-blend-mode: multiply;
  }

  /* A soft wash so the words stay readable over the scenes. */
  .wash {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to bottom, rgba(245, 241, 230, 0.8), rgba(245, 241, 230, 0.15) 28%, rgba(245, 241, 230, 0.15) 62%, rgba(245, 241, 230, 0.85));
  }

  /* --- the top bar ---------------------------------------------------------------------------- */
  .topbar {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-block-size: var(--bar);
    padding: 0.4rem 0.75rem 0.55rem;
    background: color-mix(in srgb, var(--ivory) 82%, transparent);
    backdrop-filter: blur(8px);
    border-block-end: 1px solid #e3d6b8;
  }

  .where {
    flex: 1;
    margin: 0;
    font-family: var(--font-reading);
    color: var(--burgundy);
    font-size: 0.95rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .nav {
    display: flex;
    gap: 0.4rem;
  }

  .icon-button,
  .rail-close,
  .other-liturgy {
    min-block-size: 44px;
    border: 1px solid color-mix(in srgb, var(--gold) 60%, transparent);
    border-radius: 0.6rem;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
    padding-inline: 0.8rem;
  }

  .icon-button {
    inline-size: 44px;
    padding: 0;
    display: grid;
    place-items: center;
    color: var(--ink);
  }

  .rail-close {
    color: var(--parchment);
  }

  :global([dir='rtl']) .step svg {
