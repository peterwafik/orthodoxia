  .progress span {
    display: block;
    block-size: 100%;
    inline-size: 0;
    background: linear-gradient(90deg, var(--gold), var(--gold-bright));
    transition: inline-size 0.3s ease;
  }

  /* --- the options (text size and the link to the other liturgies) ---------------------------------------------------- */
  .options {
    position: absolute;
    inset-block-start: calc(100% + 0.4rem);
