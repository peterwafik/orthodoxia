---
import { DEFAULT_EDITION, EDITIONS, bookBySlug } from '@orthodoxia/bible';
import Base from '../../../../../layouts/Base.astro';
import EditionSwitch from '../../../../../components/bible/EditionSwitch.astro';
import { biblePath, bookName, editionBooks, equivalentPath } from '../../../../../lib/bible.ts';
import { otherLocale, t, type Locale } from '../../../../../i18n/index.ts';

export function getStaticPaths() {
  return EDITIONS.flatMap((edition) =>
    editionBooks(edition.id).map(({ info }) => ({
      params: { lang: edition.locale, edition: edition.id, book: info.slug },
    })),
  );
}

const locale = Astro.params.lang as Locale;
const edition = Astro.params.edition!;
const info = bookBySlug(Astro.params.book!)!;
const chapters = editionBooks(edition).find((entry) => entry.info.code === info.code)!.chapters;
const strings = t(locale).bible;
const name = bookName(info, locale);
const other = otherLocale(locale);
---

<Base locale={locale} title={name} alternates={{ [other]: equivalentPath(edition, DEFAULT_EDITION[other], info.code, null) }}>
  <div class="wrap section">
    <p class="crumbs"><a href={biblePath(locale, edition)}>{strings.allBooks}</a></p>
    <h1>{name}</h1>
    <EditionSwitch locale={locale} edition={edition} book={info.code} />
    <h2 class="visually-hidden">{strings.chapters}</h2>
    <ol class="chapters">
      {
        chapters.map((chapter) => (
          <li>
            <a href={biblePath(locale, edition, info, chapter)} aria-label={`${strings.chapter} ${chapter}`}>
              {chapter}
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</Base>

<style>
  h1 {
    font-size: var(--step-3);
  }

  .crumbs {
    font-size: var(--step--1);
    margin-block-end: 0.5rem;
  }

  .chapters {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(3.25rem, 1fr));
    gap: 0.5rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
    max-inline-size: 48rem;
  }

  .chapters a {
    display: grid;
    place-items: center;
    block-size: 3.25rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    color: var(--ink);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }

  .chapters a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
