---
import {
  DEFAULT_EDITION,
  EDITIONS,
  bookBySlug,
  convertPsalm,
  equivalentLocation,
  getEdition,
  type BookInfo,
  type TextSourceId,
} from '@orthodoxia/bible';
import Base from '../../../../../../layouts/Base.astro';
import ChapterText from '../../../../../../components/bible/ChapterText.astro';
import VerseBubble from '../../../../../../components/bible/VerseBubble.astro';
import TopicMarkers from '../../../../../../components/bible/TopicMarkers.astro';
import { chapterKey } from '../../../../../../lib/topics/marks.ts';
import { chapterCommentary } from '../../../../../../lib/commentary.ts';
import EditionSwitch from '../../../../../../components/bible/EditionSwitch.astro';
import { biblePath, bookName, editionBooks, equivalentPath, loadBook } from '../../../../../../lib/bible.ts';
import { LICENSE_LABELS, getSource } from '../../../../../../lib/sources.ts';
import { explorerPath, otherLocale, t, type Locale } from '../../../../../../i18n/index.ts';

export function getStaticPaths() {
  return EDITIONS.flatMap((edition) =>
    editionBooks(edition.id).flatMap(({ info, chapters }) =>
      chapters.map((chapter) => ({
        params: { lang: edition.locale, edition: edition.id, book: info.slug, chapter: String(chapter) },
      })),
    ),
  );
}

/** Registry entries (content/sources) behind each raw text source. */
const REGISTRY: Readonly<Record<TextSourceId, string>> = {
  'ebible-eng-kjv': 'ebible-king-james-version-apocrypha',
  'ebible-eng-brenton': 'ebible-brenton-septuagint',
  'ebible-arb-vd': 'ebible-arabic-van-dyck',
  'wikisource-ar-dc': 'wikisource-arabic-deuterocanon',
};

const locale = Astro.params.lang as Locale;
const editionId = Astro.params.edition!;
const edition = getEdition(editionId)!;
const info = bookBySlug(Astro.params.book!)!;
const number = Number(Astro.params.chapter);
const strings = t(locale).bible;
const book = loadBook(editionId, info.code);
const chapter = book.chapters.find((candidate) => candidate.number === number)!;
const source = getSource(REGISTRY[book.source]);

// Previous and next chapters, continuing across books in this edition's order.
const sequence = editionBooks(editionId).flatMap(({ info: entry, chapters }) =>
  chapters.map((chapterNumber) => ({ info: entry, chapter: chapterNumber })),
);
const position = sequence.findIndex((entry) => entry.info.code === info.code && entry.chapter === number);
const previous = sequence[position - 1];
const next = sequence[position + 1];
const chapters = editionBooks(editionId).find((entry) => entry.info.code === info.code)!.chapters;
const single = chapters.length === 1;

const name = bookName(info, locale);
const heading = single ? name : info.code === 'PSA' ? `${strings.psalm} ${number}` : `${name} ${number}`;
const label = (entry: { info: BookInfo; chapter: number }): string =>
  `${bookName(entry.info, locale)} ${entry.chapter}`;

let psalmNote: string | null = null;
if (info.code === 'PSA') {
  if (edition.psalms === 'lxx') {
    const hebrew = convertPsalm(number, 'lxx', 'hebrew');
    psalmNote = strings.lxxPsalm(number, hebrew === undefined ? '' : String(hebrew));
  } else {
    const lxx = convertPsalm(number, 'hebrew', 'lxx');
    psalmNote = strings.hebrewPsalm(number, lxx === undefined ? '' : String(lxx));
  }
}

// The cross-reference explorer uses KJV numbering for the 66 books.
// Interpretation: the commentary is keyed to the Arabic (Van Dyck) edition's books and chapters.
const arabicLocation = editionId === 'svd' ? { book: info.code, chapter: number } : equivalentLocation(editionId, 'svd', { book: info.code, chapter: number });
const commentary =
  arabicLocation !== null && arabicLocation.chapter !== null ? chapterCommentary(arabicLocation.book, arabicLocation.chapter) : null;
const arabicHref = editionId === 'svd' ? undefined : equivalentPath(editionId, 'svd', info.code, number);

const explorerReady =
  info.section !== 'deuterocanon' && (edition.explorerCompatible || (info.section === 'nt' && book.source === 'ebible-eng-kjv'));
const explorerHref = `${explorerPath(locale, 'threads')}?ref=${info.osis}.${number}`;

const topicChapter = chapterKey(info.code, number, edition.psalms) ?? null;
const topicsLenient = info.code === 'PSA' && edition.psalms === 'lxx';
const verseExplorerHref = explorerReady ? `${explorerHref}.{verse}` : undefined;

const other = otherLocale(locale);
const licenseLabel =
  source.license.id === 'public-domain' ? strings.licenses['public-domain'] : source.license.id === 'CC-BY-SA-4.0' ? strings.licenses['cc-by-sa'] : LICENSE_LABELS[source.license.id];
// Everything a reader may want to know about the text, folded behind the ⓘ button.
const notes = [
  psalmNote,
  book.note?.[locale] ?? null,
  book.source === 'wikisource-ar-dc' ? strings.arabicDeuterocanonNotice : null,
  info.section === 'deuterocanon' && book.source !== 'wikisource-ar-dc' ? strings.deuterocanonNote : null,
  editionId === 'svd' && commentary?.stMark?.repaired ? t(locale).commentary.repairedNotice : null,
  editionId === 'svd' && commentary?.stMark && info.section === 'deuterocanon' ? t(locale).commentary.numberingNotice : null,
  `${strings.source}: ${source.title} (${licenseLabel})`,
].filter((note): note is string => note !== null);
---

<Base
  locale={locale}
  title={`${heading} (${edition.shortName})`}
  description={chapter.verses[0]?.content.map((inline) => inline.text).join('').slice(0, 155) ?? name}
  alternates={{ [other]: equivalentPath(editionId, DEFAULT_EDITION[other], info.code, number) }}
>
  <article class="wrap section reader">
    <p class="crumbs">
      <a href={biblePath(locale, editionId)}>{strings.allBooks}</a>
      {!single && (
        <>
          <span aria-hidden="true"> / </span>
          <a href={biblePath(locale, editionId, info)}>{name}</a>
        </>
      )}
    </p>
    <div class="title-row">
      <h1>{heading}</h1>
      {notes.length > 0 && (
        <details class="about">
          <summary aria-label={t(locale).commentary.aboutText} title={t(locale).commentary.aboutText}>
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
              <path d="M12 11v6M12 7.5v.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
            </svg>
          </summary>
          <div class="about-body">
            {notes.map((note) => <p>{note}</p>)}
          </div>
        </details>
      )}
    </div>
    <EditionSwitch locale={locale} edition={editionId} book={info.code} chapter={number} />

    <div class="text-host" data-has-commentary="">
      <ChapterText chapter={chapter} lang={edition.locale} notesLabel={strings.notes} />
      <VerseBubble locale={locale} commentary={commentary} arabicHref={arabicHref} explorerHref={verseExplorerHref} />
    </div>

    <TopicMarkers locale={locale} book={info.code} chapterKey={topicChapter} lenient={topicsLenient} />

    <nav class="pager" aria-label={strings.chapters}>
      {previous !== undefined ? (
        <a class="prev" href={biblePath(locale, editionId, previous.info, previous.chapter)} rel="prev">
          <span class="muted">{strings.previous}</span>
          <span>{label(previous)}</span>
        </a>
      ) : <span />}
      {next !== undefined && (
        <a class="next" href={biblePath(locale, editionId, next.info, next.chapter)} rel="next">
          <span class="muted">{strings.next}</span>
          <span>{label(next)}</span>
        </a>
      )}
    </nav>

    {!single && (
      <details class="picker">
        <summary>{strings.chooseChapter}</summary>
        <ol>
          {chapters.map((candidate) => (
            <li>
              <a href={biblePath(locale, editionId, info, candidate)} aria-current={candidate === number ? 'page' : undefined}>
                {candidate}
              </a>
            </li>
          ))}
        </ol>
      </details>
    )}
  </article>
</Base>

<style>
  /* The chapter and nothing else, across the whole page width. */
  .reader {
    max-inline-size: none;
  }

  .reader h1 {
    font-size: var(--step-3);
    margin: 0;
  }

  .crumbs {
    font-size: var(--step--1);
    margin-block-end: 0.5rem;
  }

  .title-row {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-block-end: 1rem;
  }

  .about summary {
    display: inline-grid;
    place-items: center;
    inline-size: 36px;
    block-size: 36px;
    border-radius: 50%;
    color: var(--ink-muted);
    cursor: pointer;
    list-style: none;
  }

  .about summary::-webkit-details-marker {
    display: none;
  }

  .about summary:hover,
  .about[open] summary {
    background: var(--line);
    color: var(--ink);
  }

  .about-body {
    position: absolute;
    inset-inline: 0;
    inset-block-start: calc(100% + 0.25rem);
    z-index: 6;
    max-inline-size: 34rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface-raised);
    box-shadow: 0 12px 32px rgb(14 26 51 / 0.15);
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .about-body p {
    margin-block: 0 0.6rem;
  }

  .about-body p:last-child {
    margin-block-end: 0;
  }

  /* Positioning context for the verse bubble. */
  .text-host {
    position: relative;
    margin-block-start: 2rem;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    max-inline-size: var(--measure);
    margin-block-start: 3rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--line);
  }

  .pager a {
    display: grid;
    gap: 0.15rem;
    text-decoration: none;
    color: var(--ink);
    min-block-size: 44px;
  }

  .pager a:hover span:last-child {
    color: var(--accent);
    text-decoration: underline;
  }

  .pager .muted {
    font-size: var(--step--1);
  }

  .next {
    text-align: end;
  }

  .picker {
    margin-block-start: 2rem;
    max-inline-size: var(--measure);
  }

  .picker summary {
    cursor: pointer;
    min-block-size: 44px;
    display: flex;
    align-items: center;
    color: var(--accent);
  }

  .picker ol {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(2.75rem, 1fr));
    gap: 0.35rem;
    padding: 0;
    list-style: none;
  }

  .picker a {
    display: grid;
    place-items: center;
    block-size: 2.75rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    text-decoration: none;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .picker a[aria-current='page'] {
    background: var(--ink);
    color: var(--surface);
  }

</style>
