---
import Base from '../../layouts/Base.astro';
import CardArt from '../../components/CardArt.astro';
import HomeHeroArt from '../../components/HomeHeroArt.astro';
import { LOCALES, explorerPath, localePath, t, type Locale } from '../../i18n/index.ts';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const strings = t(locale);
const cards = [
  { art: 'bible' as const, ...strings.home.cards.bible, href: localePath(locale, 'bible') },
  { art: 'explore' as const, ...strings.home.cards.explore, href: explorerPath(locale) },
  { art: 'threads' as const, ...strings.home.cards.threads, href: explorerPath(locale, 'threads') },
  { art: 'holyMass' as const, ...strings.home.cards.holyMass, href: localePath(locale, 'holy-mass') },
  { art: 'churchHistory' as const, ...strings.home.cards.churchHistory, href: localePath(locale, 'church-history') },
  { art: 'about' as const, ...strings.home.cards.about, href: localePath(locale, 'about') },
];
---

<Base locale={locale} simpleHeader>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <h1>{strings.home.title}</h1>
        <p class="lede">{strings.home.lede}</p>
      </div>
      <HomeHeroArt />
    </div>
  </section>

  <section class="cards-section">
    <div class="wrap">
      <ul class="cards">
        {
          cards.map(({ art, title, note, href }) => (
            <li>
              <a class="card" href={href}>
                <CardArt name={art} />
                <span class="card-title">{title}</span>
                <span class="card-note">{note}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

</Base>

<style>
  .hero {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) 1rem;
  }

  /* The text, and the drawing beside it on a wide screen (below it, smaller, on a narrow one). */
  .hero-grid {
    display: grid;
    gap: 1.5rem 3rem;
    align-items: center;
  }

  .hero-grid :global(.hero-art) {
    inline-size: min(100%, 22rem);
    margin-inline: auto;
  }

  @media (min-width: 52rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .hero-grid :global(.hero-art) {
      /* fills the space between the text and the edge of the page */
      inline-size: 100%;
      margin: 0;
    }
  }

  h1 {
    font-size: var(--step-hero);
    max-inline-size: 18em;
    letter-spacing: -0.01em;
    margin-block-end: 1rem;
  }

  :lang(ar) h1 {
    letter-spacing: 0;
  }

  .lede {
    font-family: var(--font-reading);
    font-size: var(--step-1);
    max-inline-size: 32em;
    margin: 0;
    color: var(--ink-muted);
  }

  .cards-section {
    padding-block: 2rem clamp(2rem, 5vw, 3.5rem);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    block-size: 100%;
    padding: 1.4rem 1.4rem 1.6rem;
    border: 1px solid var(--line);
    border-block-start: 3px solid var(--accent);
    border-radius: 4px;
    background: var(--surface-raised);
    color: var(--ink);
    text-decoration: none;
  }

  .card:hover {
    border-color: var(--accent);
  }

  .card-title {
    font-family: var(--font-reading);
    font-size: var(--step-2);
    font-weight: 600;
  }

  .card:hover .card-title {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .card-note {
    color: var(--ink-muted);
  }
</style>
