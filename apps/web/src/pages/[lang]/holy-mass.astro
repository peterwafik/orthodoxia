---
/**
 * The Holy Mass journey: the Divine Liturgy as one continuous picture. Scrolling the prayer panel
 * moves a camera over a single enlarged artwork (a tiled deep-zoom pyramid), from the earthly church
 * toward the heavenly assembly. The camera maths are in lib/holy-mass/camera.ts; the stops and their
 * camera regions are in data/holy-mass.ts.
 */
import { bookByCode } from '@orthodoxia/bible';
import Base from '../../layouts/Base.astro';
import { bookName, biblePath } from '../../lib/bible.ts';
import { LOCALES, localePath, otherLocale, t, type Locale } from '../../i18n/index.ts';
import { CHAPTERS, LITURGIES, REGIONS, STOPS, stopHash } from '../../data/holy-mass.ts';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const other = otherLocale(locale);
const edition = locale === 'ar' ? 'svd' : 'kjv';

const UI = {
  en: {
    title: 'Holy Mass',
    description: 'The Coptic Orthodox Divine Liturgy as a journey: follow the prayers from the earthly church toward the heavenly worship, stop by stop.',
    heading: 'A journey into heaven',
    sub: 'The Coptic Orthodox Divine Liturgy: from earthly worship to heavenly communion',
    begin: 'Scroll to begin',
    journey: 'The Liturgy journey',
    stopsCount: (n: number) => `${n} stops`,
    stopOf: (n: number, total: number) => `Stop ${n} of ${total}`,
    previous: 'Previous',
    next: 'Next',
    liturgy: 'Liturgy',
    both: 'Both languages',
    prayAlong: 'Pray along',
    priest: 'Priest',
    people: 'People',
    prayerPending: 'The text of this prayer will be added from an authorized translation.',
    what: 'What is happening',
    meaning: 'What it means',
    silently: 'Pray silently',
    meditationNote: 'A personal meditation, not a liturgical text.',
    artwork: 'In the artwork',
    scripture: 'Scripture',
    varies: (liturgy: string) => `This part differs in each of the three liturgies. The text for ${liturgy} will be added from an authorized translation.`,
    draftOutline: 'Draft. The order follows the outline of copticorthodoxliturgy.com; the explanation has not yet been reviewed by clergy.',
    draftGeneral: 'Draft. A connecting stop added for the journey; not yet reviewed by clergy.',
    resume: (n: number) => `Resume at stop ${n}`,
    stopsButton: 'Stops',
    options: 'Options',
    close: 'Close',
    disclaimer: 'The artwork is a symbolic visual meditation inspired by Coptic Orthodox worship, not a literal picture of heaven.',
    viewportLabel: 'Artwork of the Divine Liturgy. The camera follows the prayer you are reading.',
    imageNote: 'The artwork is enlarged from a 1280-pixel original; a higher-resolution master will sharpen the deepest zoom.',
  },
  ar: {
    title: 'القداس الإلهي',
    description: 'القداس الإلهي القبطي الأرثوذكسي كرحلة: تتبّع الصلوات من الكنيسة الأرضية نحو العبادة السماوية، محطة بعد محطة.',
    heading: 'رحلة إلى السماء',
    sub: 'القداس الإلهي القبطي الأرثوذكسي: من العبادة الأرضية إلى الشركة السماوية',
    begin: 'مرّر للأسفل لتبدأ',
    journey: 'رحلة القداس',
    stopsCount: (n: number) => `${n} محطة`,
    stopOf: (n: number, total: number) => `المحطة ${n} من ${total}`,
    previous: 'السابق',
    next: 'التالي',
    liturgy: 'القداس',
    both: 'اللغتان معًا',
    prayAlong: 'صلِّ معنا',
    priest: 'الكاهن',
    people: 'الشعب',
    prayerPending: 'سيُضاف نص هذه الصلاة من ترجمة معتمدة.',
    what: 'ماذا يحدث',
    meaning: 'ماذا يعني',
    silently: 'صلاة صامتة',
    meditationNote: 'تأمل شخصي وليس نصًّا ليتورجيًّا.',
    artwork: 'في اللوحة',
    scripture: 'من الكتاب المقدس',
    varies: (liturgy: string) => `يختلف هذا الجزء في كل من القداسات الثلاثة. سيُضاف نص ${liturgy} من ترجمة معتمدة.`,
    draftOutline: 'مسودة. الترتيب يتبع مخطط موقع copticorthodoxliturgy.com، ولم يُراجَع الشرح من الآباء الكهنة بعد.',
    draftGeneral: 'مسودة. محطة وصل أُضيفت للرحلة ولم تُراجَع من الآباء الكهنة بعد.',
    resume: (n: number) => `تابع من المحطة ${n}`,
    stopsButton: 'المحطات',
    options: 'خيارات',
    close: 'إغلاق',
    disclaimer: 'اللوحة تأمل بصري رمزي مستوحى من العبادة القبطية الأرثوذكسية، وليست صورة حرفية للسماء.',
    viewportLabel: 'لوحة القداس الإلهي. تتبع الكاميرا الصلاة التي تقرؤها.',
    imageNote: 'اللوحة مكبَّرة من أصل بعرض ١٢٨٠ بكسل؛ وستزيد نسخة بدقة أعلى من وضوح أعمق تقريب.',
  },
} as const;
const ui = UI[locale];

const total = STOPS.length;
const stopsByChapter = CHAPTERS.map((chapter) => ({ chapter, stops: STOPS.filter((stop) => stop.chapter === chapter.id) }));

function scriptureLinks(stop: (typeof STOPS)[number]) {
  return stop.scripture.flatMap((reference) => {
    const info = bookByCode(reference.book);
    if (info === undefined) return [];
    const verse = reference.verses === undefined ? '' : `#v${reference.verses.split(/[-,]/)[0]}`;
    const label = `${bookName(info, locale)} ${reference.chapter}${reference.verses === undefined ? '' : `: ${reference.verses}`}`;
    return [{ href: `${biblePath(locale, edition, info, reference.chapter)}${verse}`, label }];
  });
}

const clientStops = STOPS.map((stop) => ({ n: stop.n, hash: stopHash(stop), box: stop.box, region: stop.region }));
---

<Base locale={locale} title={ui.title} description={ui.description} minimalFooter>
  <div class="journey" data-journey data-total={total} data-locale={locale}>
    <aside class="rail" id="hm-rail" aria-label={ui.journey}>
      <div class="rail-head">
        <p class="rail-title">{ui.journey}</p>
        <p class="rail-count">{ui.stopsCount(total)}</p>
        <button type="button" class="rail-close" data-rail-close>{ui.close}</button>
      </div>
      <ol class="rail-chapters">
        {
          stopsByChapter.map(({ chapter, stops }) => (
            <li>
              <details open={chapter.id === 1} data-chapter={chapter.id}>
                <summary>
                  <span class="num">{['I', 'II', 'III', 'IV', 'V'][chapter.id - 1]}</span>
                  <span class="name">{chapter.title[locale]}</span>
                  <span class="range">
                    {stops[0]!.n}–{stops.at(-1)!.n}
                  </span>
                </summary>
                <ol class="rail-stops">
                  {stops.map((stop) => (
                    <li>
                      <a href={`#${stopHash(stop)}`} data-stop={stop.n}>
                        <span class="n">{stop.n}</span>
                        <span class="t">{stop.title[locale]}</span>
                      </a>
                    </li>
                  ))}
                </ol>
              </details>
            </li>
          ))
        }
      </ol>
    </aside>

    <section class="stage" aria-label={ui.viewportLabel}>
      <canvas class="art" data-art role="img" aria-label={ui.viewportLabel}></canvas>
      <div class="vignette" aria-hidden="true"></div>
      <div class="grain" aria-hidden="true"></div>
      <div class="opening" data-opening>
        <p class="eyebrow">{ui.sub}</p>
        <h1>{ui.heading}</h1>
        <p class="begin">{ui.begin}</p>
      </div>
      <p class="stage-note" data-stage-note>
        <strong data-region-title></strong>
      </p>
    </section>

    <section class="panel" aria-label={ui.journey}>
      <header class="panel-head">
        <div class="head-row">
          <button type="button" class="stops-button" data-rail-open aria-controls="hm-rail" aria-expanded="false">{ui.stopsButton}</button>
          <p class="where" data-where aria-live="polite"></p>
          <button type="button" class="stops-button" data-options-toggle aria-controls="hm-options" aria-expanded="false">{ui.options}</button>
          <div class="nav">
            <button type="button" class="step" data-prev aria-label={ui.previous}>
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="m14 6-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </button>
            <button type="button" class="step" data-next aria-label={ui.next}>
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="m10 6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </button>
          </div>
        </div>
        <div class="progress" aria-hidden="true"><span data-progress></span></div>
        <div class="options" id="hm-options" data-options>
          <div class="liturgies" role="radiogroup" aria-label={ui.liturgy}>
            {
              LITURGIES.map((liturgy, index) => (
                <button type="button" role="radio" aria-checked={index === 0 ? 'true' : 'false'} data-liturgy={liturgy.id} data-name={liturgy.title[locale]}>
                  {liturgy.title[locale]}
                </button>
              ))
            }
          </div>
          <label class="both"><input type="checkbox" data-both /> <span>{ui.both}</span></label>
        </div>
        <p class="resume" data-resume hidden><a href="#" data-resume-link></a></p>
      </header>

      <div class="panel-scroll" data-scroller tabindex="0">
        {
          STOPS.map((stop) => {
            const region = REGIONS[stop.region];
            const links = scriptureLinks(stop);
            return (
              <article class="stop" id={`stop-${stopHash(stop)}`} data-n={stop.n} data-region={stop.region} aria-labelledby={`h-${stop.n}`}>
                <p class="chapter-label">
                  {CHAPTERS[stop.chapter - 1]!.title[locale]} · {ui.stopOf(stop.n, total)}
                </p>
                <h2 id={`h-${stop.n}`}>{stop.title[locale]}</h2>
                <p class="alt-title" lang={other} dir={other === 'ar' ? 'rtl' : 'ltr'}>
                  {stop.title[other]}
                </p>

                {stop.dialogue !== undefined ? (
                  <section class="prayer">
                    <h3>{ui.prayAlong}</h3>
                    {stop.dialogue.map((line) => (
                      <p class={`line ${line.role}`}>
                        <span class="role">{line.role === 'priest' ? ui.priest : ui.people}</span>
                        <span class="text">{line.text[locale]}</span>
                        <span class="text other-lang" lang={other} dir={other === 'ar' ? 'rtl' : 'ltr'}>
                          {line.text[other]}
                        </span>
                      </p>
                    ))}
                  </section>
                ) : (
                  <p class="pending">{ui.prayerPending}</p>
                )}

                <section>
                  <h3>{ui.what}</h3>
                  <p>{stop.what[locale]}</p>
                  <p class="other-lang" lang={other} dir={other === 'ar' ? 'rtl' : 'ltr'}>
                    {stop.what[other]}
                  </p>
                </section>
                <section>
                  <h3>{ui.meaning}</h3>
                  <p>{stop.meaning[locale]}</p>
                  <p class="other-lang" lang={other} dir={other === 'ar' ? 'rtl' : 'ltr'}>
                    {stop.meaning[other]}
                  </p>
                </section>
                <section class="silent">
                  <h3>{ui.silently}</h3>
                  <p class="quote">{stop.meditate[locale]}</p>
                  <p class="quote other-lang" lang={other} dir={other === 'ar' ? 'rtl' : 'ltr'}>
                    {stop.meditate[other]}
                  </p>
                  <p class="tiny">{ui.meditationNote}</p>
                </section>
                <section class="artnote">
                  <h3>{ui.artwork}</h3>
                  <p>
                    <strong>{region.title[locale]}.</strong> {region.note[locale]}
                  </p>
                  <p class="other-lang" lang={other} dir={other === 'ar' ? 'rtl' : 'ltr'}>
                    <strong>{region.title[other]}.</strong> {region.note[other]}
                  </p>
                </section>
                {links.length > 0 && (
                  <section class="refs">
                    <h3>{ui.scripture}</h3>
                    <ul>
                      {links.map((link) => (
                        <li>
                          <a href={link.href}>{link.label}</a>
                        </li>
                      ))}
                    </ul>
                  </section>
                )}
                {stop.varies === true && <p class="varies" data-varies>{ui.varies('…')}</p>}
                <p class="tiny draft">{stop.basis === 'outline' ? ui.draftOutline : ui.draftGeneral}</p>
              </article>
            );
          })
        }
        <footer class="panel-foot">
          <p>{ui.disclaimer}</p>
          <p>{ui.imageNote}</p>
          <p><a href={localePath(locale, 'sources')}>{t(locale).nav.sources}</a></p>
        </footer>
      </div>
    </section>
  </div>

  <script type="application/json" id="hm-stops" set:html={JSON.stringify(clientStops)}></script>
  <script type="application/json" id="hm-regions" set:html={JSON.stringify(Object.fromEntries(Object.entries(REGIONS).map(([id, region]) => [id, region.title[locale]])))}></script>
  <script type="application/json" id="hm-ui" set:html={JSON.stringify({ stopOf: ui.stopOf(0, total).replace('0', '{n}'), varies: ui.varies('{liturgy}'), resume: ui.resume(0).replace('0', '{n}') })}></script>
</Base>

<script>
  import { frameAt, frameFor, heightPerWidth, visibleTiles, type Frame, type FocusBox, type PyramidMeta } from '../../lib/holy-mass/camera.ts';

  interface ClientStop {
    n: number;
    hash: string;
    box: FocusBox;
    region: string;
  }

  const root = document.querySelector<HTMLElement>('[data-journey]');
  if (root !== null) {
    const stops = JSON.parse(document.getElementById('hm-stops')!.textContent!) as ClientStop[];
    const regions = JSON.parse(document.getElementById('hm-regions')!.textContent!) as Record<string, string>;
    const text = JSON.parse(document.getElementById('hm-ui')!.textContent!) as { stopOf: string; varies: string; resume: string };
    const total = stops.length;
    const canvas = root.querySelector<HTMLCanvasElement>('[data-art]')!;
    const stage = root.querySelector<HTMLElement>('.stage')!;
    const scroller = root.querySelector<HTMLElement>('[data-scroller]')!;
    const articles = [...scroller.querySelectorAll<HTMLElement>('.stop')];
    const railLinks = [...root.querySelectorAll<HTMLAnchorElement>('[data-stop]')];
    const opening = root.querySelector<HTMLElement>('[data-opening]')!;
    const where = root.querySelector<HTMLElement>('[data-where]')!;
    const progress = root.querySelector<HTMLElement>('[data-progress]')!;
    const regionTitle = root.querySelector<HTMLElement>('[data-region-title]')!;
    const rail = root.querySelector<HTMLElement>('#hm-rail')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const ctx = canvas.getContext('2d', { alpha: false })!;

    // ---- layout: fit the journey under the site header ----------------------------------------
    const header = document.querySelector<HTMLElement>('.site-header');
    const fit = () => root.style.setProperty('--hm-header', `${header?.offsetHeight ?? 0}px`);
    fit();
    if (header !== null && typeof ResizeObserver !== 'undefined') new ResizeObserver(fit).observe(header);

    // ---- the artwork: a tile pyramid over a preview --------------------------------------------
    let meta: PyramidMeta | null = null;
    const preview = new Image();
    let previewReady = false;
    preview.onload = () => {
      previewReady = true;
      requestRender();
    };
    preview.src = '/holy-mass/preview.jpg';
    fetch('/holy-mass/meta.json')
      .then((response) => response.json() as Promise<PyramidMeta & { format: string }>)
      .then((value) => {
        meta = value;
        resize();
      })
      .catch(() => undefined);

    const tiles = new Map<string, HTMLImageElement>();
    const MAX_TILES = 220;
    function tile(level: number, col: number, row: number): HTMLImageElement {
      const key = `${level}/${col}_${row}`;
      let image = tiles.get(key);
      if (image === undefined) {
        image = new Image();
        image.decoding = 'async';
        image.onload = requestRender;
        image.src = `/holy-mass/tiles/${key}.jpeg`;
        tiles.set(key, image);
        if (tiles.size > MAX_TILES) {
          // Drop the least recently requested tiles (Map keeps insertion order).
          for (const stale of tiles.keys()) {
            tiles.delete(stale);
            if (tiles.size <= MAX_TILES * 0.8) break;
          }
        }
      } else {
        tiles.delete(key);
        tiles.set(key, image);
      }
      return image;
    }

    let view = { width: 1, height: 1 };
    let dpr = 1;
    let frames: Frame[] = [];
    let k = 1;
    let current: Frame = { cx: 0.5, cy: 0.5, vw: 1 };
    const IMAGE = { width: 1280, height: 960 };

    function resize() {
      const rect = stage.getBoundingClientRect();
      view = { width: Math.max(1, rect.width), height: Math.max(1, rect.height) };
      dpr = Math.min(window.devicePixelRatio || 1, 2.5);
      canvas.width = Math.round(view.width * dpr);
      canvas.height = Math.round(view.height * dpr);
      k = heightPerWidth(view, IMAGE);
      frames = stops.map((stop) => frameFor(stop.box, view, IMAGE));
      measure();
      update();
    }

    let frameRequested = false;
    function requestRender() {
      if (frameRequested) return;
      frameRequested = true;
      requestAnimationFrame(() => {
        frameRequested = false;
        draw();
      });
    }

    function draw() {
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.fillStyle = '#07172c';
      ctx.fillRect(0, 0, view.width, view.height);
      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = 'high';
      const vh = current.vw * k;
      const left = current.cx - current.vw / 2;
      const top = current.cy - vh / 2;
      // Where the whole picture lands in the window: the base layer, and the margin if any.
      const scale = view.width / current.vw; // px per image-width
      const full = IMAGE.width / IMAGE.height;
      const imgW = scale;
      const imgH = scale / full;
      const dx = -left * imgW;
      const dy = -top * imgH; // top is a fraction of the image height
      if (previewReady) ctx.drawImage(preview, dx, dy, imgW, imgH);
      if (meta !== null) {
        const wanted = visibleTiles(current, view, dpr, meta);
        for (const draw of wanted) {
          const image = tile(draw.level, draw.col, draw.row);
          if (image.complete && image.naturalWidth > 0) {
            // A hair of overlap hides the seams between neighbouring tiles.
            ctx.drawImage(image, 0, 0, draw.tw, draw.th, draw.x - 0.25, draw.y - 0.25, draw.w + 0.5, draw.h + 0.5);
          }
        }
      }
    }

    // ---- scroll → camera ----------------------------------------------------------------------
    let tops: number[] = [];
    function measure() {
      tops = articles.map((article) => article.offsetTop - articles[0]!.offsetTop);
    }

    function position(): number {
      const y = scroller.scrollTop;
      if (tops.length === 0) return 0;
      let i = tops.length - 1;
      while (i > 0 && tops[i]! > y) i--;
      const next = tops[i + 1];
      if (next === undefined) return i;
      return i + Math.min(1, Math.max(0, (y - tops[i]!) / (next - tops[i]!)));
    }

    let active = -1;
    let visitedMax = 0;
    // The address and the saved place are only written once the reader has moved.
    let interacted = false;
    const initialHash = decodeURIComponent(location.hash.slice(1));
    function update() {
      const p = position();
      const nearest = Math.round(p);
      current = frames.length === 0 ? current : reduced.matches ? frames[nearest]! : frameAt(frames, p, k);
      // The title fades as the camera leaves the wide opening view.
      opening.style.opacity = String(Math.min(1, Math.max(0, (current.vw - 0.8) / 0.17)));
      requestRender();
      if (nearest !== active) {
        active = nearest;
        visitedMax = Math.max(visitedMax, active);
        const stop = stops[active]!;
        where.textContent = text.stopOf.replace('{n}', String(stop.n));
        progress.style.inlineSize = `${((active + 1) / total) * 100}%`;
        regionTitle.textContent = regions[stop.region] ?? '';
        for (const link of railLinks) {
          const n = Number(link.dataset['stop']);
          if (n === stop.n) {
            link.setAttribute('aria-current', 'step');
            link.closest('details')?.setAttribute('open', '');
          } else {
            link.removeAttribute('aria-current');
          }
          link.classList.toggle('done', n <= visitedMax && n !== stop.n);
        }
        const note = railLinks.find((link) => Number(link.dataset['stop']) === stop.n);
        // Keep the active stop in view inside the rail without scrolling the whole page.
        if (note !== undefined && rail.scrollHeight > rail.clientHeight) {
          const box = rail.getBoundingClientRect();
          const at = note.getBoundingClientRect();
          if (at.top < box.top + 8 || at.bottom > box.bottom - 8) rail.scrollTop += at.top - box.top - box.height / 3;
        }
        try {
          if (interacted) {
            history.replaceState(null, '', `#${stop.hash}`);
            localStorage.setItem('orthodoxia:holy-mass', String(stop.n));
          }
        } catch {
          // Storage or history unavailable: the journey still works.
        }
        // Warm the tiles of the next stop so the camera arrives on sharp ground.
        const upcoming = frames[active + 1];
        if (upcoming !== undefined && meta !== null) for (const draw of visibleTiles(upcoming, view, dpr, meta)) tile(draw.level, draw.col, draw.row);
      }
    }

    let scrollRequested = false;
    scroller.addEventListener(
      'scroll',
      () => {
        interacted = true;
        if (scrollRequested) return;
        scrollRequested = true;
        requestAnimationFrame(() => {
          scrollRequested = false;
          update();
        });
      },
      { passive: true },
    );

    function goTo(index: number, smooth = true) {
      const clamped = Math.min(total - 1, Math.max(0, index));
      scroller.scrollTo({ top: tops[clamped] ?? 0, behavior: smooth && !reduced.matches ? 'smooth' : 'auto' });
    }

    root.querySelector('[data-next]')?.addEventListener('click', () => goTo(Math.round(position()) + 1));
    root.querySelector('[data-prev]')?.addEventListener('click', () => goTo(Math.round(position()) - 1));
    for (const link of railLinks) {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        goTo(Number(link.dataset['stop']) - 1);
        closeRail();
      });
    }

    // ---- rail on small screens ----------------------------------------------------------------
    const openButton = root.querySelector<HTMLButtonElement>('[data-rail-open]')!;
    function closeRail() {
      rail.dataset['open'] = 'false';
      openButton.setAttribute('aria-expanded', 'false');
    }
    openButton.addEventListener('click', () => {
      rail.dataset['open'] = 'true';
      openButton.setAttribute('aria-expanded', 'true');
    });
    root.querySelector('[data-rail-close]')?.addEventListener('click', closeRail);
    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeRail();
    });

    const optionsBox = root.querySelector<HTMLElement>('[data-options]')!;
    const optionsToggle = root.querySelector<HTMLButtonElement>('[data-options-toggle]')!;
    optionsToggle.addEventListener('click', () => {
      const open = optionsBox.dataset['open'] !== 'true';
      optionsBox.dataset['open'] = String(open);
      optionsToggle.setAttribute('aria-expanded', String(open));
      requestAnimationFrame(() => {
        measure();
        update();
      });
    });

    // ---- liturgy and language options ---------------------------------------------------------
    const liturgyButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-liturgy]')];
    function setLiturgy(id: string) {
      const chosen = liturgyButtons.find((button) => button.dataset['liturgy'] === id) ?? liturgyButtons[0]!;
      for (const button of liturgyButtons) button.setAttribute('aria-checked', String(button === chosen));
      const name = chosen.dataset['name'] ?? '';
      for (const note of root!.querySelectorAll<HTMLElement>('[data-varies]')) note.textContent = text.varies.replace('{liturgy}', name);
      try {
        localStorage.setItem('orthodoxia:holy-mass:liturgy', chosen.dataset['liturgy']!);
      } catch {
        // Not saved.
      }
    }
    for (const button of liturgyButtons) button.addEventListener('click', () => setLiturgy(button.dataset['liturgy']!));
    let savedLiturgy = 'basil';
    let savedBoth = false;
    let savedStop = 0;
    try {
      savedLiturgy = localStorage.getItem('orthodoxia:holy-mass:liturgy') ?? 'basil';
      savedBoth = localStorage.getItem('orthodoxia:holy-mass:both') === '1';
      savedStop = Number(localStorage.getItem('orthodoxia:holy-mass') ?? '0');
    } catch {
      // Defaults.
    }
    setLiturgy(savedLiturgy);
    const both = root.querySelector<HTMLInputElement>('[data-both]')!;
    both.checked = savedBoth;
    const applyBoth = () => {
      root.classList.toggle('show-both', both.checked);
      try {
        localStorage.setItem('orthodoxia:holy-mass:both', both.checked ? '1' : '0');
      } catch {
        // Not saved.
      }
      measure();
    };
    both.addEventListener('change', applyBoth);
    root.classList.toggle('show-both', both.checked);

    // ---- start: deep link, or offer to resume ---------------------------------------------------
    // The stage changes size when fonts load, the header wraps, or the phone turns.
    if (typeof ResizeObserver === 'undefined') window.addEventListener('resize', resize);
    else new ResizeObserver(resize).observe(stage);
    reduced.addEventListener('change', update);
    resize();
    const fromHash = stops.findIndex((stop) => stop.hash === initialHash);
    if (fromHash > 0) {
      goTo(fromHash, false);
    } else if (savedStop > 1 && savedStop <= total) {
      const box = root.querySelector<HTMLElement>('[data-resume]')!;
      const link = root.querySelector<HTMLAnchorElement>('[data-resume-link]')!;
      link.textContent = text.resume.replace('{n}', String(savedStop));
      box.hidden = false;
      link.addEventListener('click', (event) => {
        event.preventDefault();
        box.hidden = true;
        goTo(savedStop - 1);
      });
    }
    // Fonts and wrapping change the panel's height after load.
    if (typeof ResizeObserver !== 'undefined') new ResizeObserver(() => {
      measure();
      update();
    }).observe(scroller);
    update();
  }
</script>

