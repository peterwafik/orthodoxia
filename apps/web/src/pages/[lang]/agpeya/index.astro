---
import Base from '../../../layouts/Base.astro';
import { agpeyaPath, hours, sharedSections } from '../../../lib/agpeya/load.ts';
import { ui } from '../../../lib/agpeya/ui.ts';
import { LOCALES, type Locale } from '../../../i18n/index.ts';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const ar = locale === 'ar';
const text = ui(locale);
const all = hours();
const shared = sharedSections();

/**
 * The day dial, counted the old Jewish way, as the Bible and the Agpeya count the hours: the day has twelve hours from
 * sunrise to sunset, and the night twelve from sunset to sunrise (sunrise is taken as 6 a.m. and sunset as 6 p.m.). The
 * day is the upper half (sunrise on the left, the sixth hour, noon, at the top, sunset on the right) and the night the
 * lower half (its sixth hour, midnight, at the bottom). `h` is the hours since sunrise, 0–24.
 */
const R = 150;
const sinceSunrise = (clockHour: number): number => (((clockHour - 6) % 24) + 24) % 24;
const angle = (h: number): number => ((h - 6) / 24) * 2 * Math.PI;
const point = (h: number, radius: number): { x: number; y: number } => ({
  x: Math.round((R + radius * Math.sin(angle(h))) * 10) / 10,
  y: Math.round((R - radius * Math.cos(angle(h))) * 10) / 10,
});
const digits = new Intl.NumberFormat(ar ? 'ar-EG' : 'en-US');
/** Hour n of the day ends n hours after sunrise; hour n of the night, n hours after sunset. */
const numbers = Array.from({ length: 24 }, (_, i) => ({ label: digits.format((i % 12) + 1), night: i >= 12, ...point(i + 1, 121) }));
const ORDINALS = {
  en: ['first', 'second', 'third', 'fourth', 'fifth', 'sixth', 'seventh', 'eighth', 'ninth', 'tenth', 'eleventh', 'twelfth'],
  ar: ['الأولى', 'الثانية', 'الثالثة', 'الرابعة', 'الخامسة', 'السادسة', 'السابعة', 'الثامنة', 'التاسعة', 'العاشرة', 'الحادية عشرة', 'الثانية عشرة'],
};
const nowWords = JSON.stringify({ ordinals: ORDINALS[locale], day: text.nowDay, night: text.nowNight });
/** One arm of the Coptic cross (pointed tip, flared shoulders), as offsets from the centre in tip-length units. */
const ARM: ReadonlyArray<readonly [number, number]> = [
  [-0.2, -0.5], [-0.443, -0.75], [-0.145, -0.75], [0, -1],
  [0.145, -0.75], [0.443, -0.75], [0.2, -0.5], [0.2, -0.2],
];
/** A small outlined Coptic cross: four such arms, each turned a quarter. `arm` is the centre-to-tip length. */
const cross = (x: number, y: number, arm: number): string => {
  const turns: ReadonlyArray<(dx: number, dy: number) => [number, number]> = [
    (dx, dy) => [dx, dy],
    (dx, dy) => [-dy, dx],
    (dx, dy) => [-dx, -dy],
    (dx, dy) => [dy, -dx],
  ];
  const points = turns.flatMap((turn) =>
    ARM.map(([dx, dy]) => {
      const [rx, ry] = turn(dx, dy);
      return `${Math.round((x + rx * arm) * 10) / 10} ${Math.round((y + ry * arm) * 10) / 10}`;
    }),
  );
  return `M${points.join('L')}Z`;
};
const marks = all.map((hour) => ({ hour, ...point(sinceSunrise(hour.at), 97) }));
const data = JSON.stringify(all.map((hour) => ({ id: hour.id, at: hour.at })));
---

<Base locale={locale} title={text.title} description={text.metaDescription}>
  <div class="page-stage">
    <section class="intro wrap">
      <div class="intro-text">
        <h1>{text.title}</h1>
        <p class="sub">{text.subtitle}</p>
      </div>
      <figure class="dial" data-dial data-hours={data} data-words={nowWords}>
        <svg viewBox={`-14 -14 ${R * 2 + 28} ${R * 2 + 28}`} role="presentation" aria-hidden="true">
          <path d={`M${R - 146} ${R}A146 146 0 0 0 ${R + 146} ${R}Z`} class="night"></path>
          <circle cx={R} cy={R} r="146" class="face"></circle>
          <line x1={R - 146} y1={R} x2={R + 146} y2={R} class="horizon"></line>
          {Array.from({ length: 24 }, (_, i) => i).map((i) => {
            const a = point(i, i % 6 === 0 ? 128 : 136);
            const b = point(i, 143);
            return <line x1={a.x} y1={a.y} x2={b.x} y2={b.y} class={i % 6 === 0 ? 'tick big' : 'tick'}></line>;
          })}
          {numbers.map(({ label, night, x, y }) => (
            <text x={x} y={y} class={night ? 'num night-num' : 'num'} text-anchor="middle" dominant-baseline="central">{label}</text>
          ))}
          {marks.map(({ hour, x, y }) => (
            <path d={cross(x, y, 9)} class="mark" data-mark={hour.id}></path>
          ))}
          <g class="hand" data-hand>
            <line x1={R} y1={R} x2={R} y2={R - 72} class="hand-line"></line>
            <circle cx={R} cy={R - 72} r="4.5" class="hand-dot"></circle>
          </g>
          <path d={cross(R, R, 13)} class="hub"></path>
        </svg>
        <figcaption>
          <span class="now-text" data-now-text></span>
          <span class="dial-note">{text.dialNote}</span>
        </figcaption>
      </figure>
    </section>

    <section class="hours wrap" aria-labelledby="hours-title">
      <h2 id="hours-title">{text.hours}</h2>
      <ol class="hr-list">
        {
          all.map((hour) => {
            return (
              <li data-hour-card={hour.id} data-at={hour.at}>
                <a class="hr" href={agpeyaPath(locale, hour.id)}>
                  <span class="now" hidden>{text.prayNow}</span>
                  <span class="hr-time">{hour.time[locale]}</span>
                  <span class="hr-title">{hour.title[locale]}</span>
                  <span class="hr-other" lang={ar ? 'en' : 'ar'} dir={ar ? 'ltr' : 'rtl'}>{hour.title[ar ? 'en' : 'ar']}</span>
                </a>
              </li>
            );
          })
        }
      </ol>
    </section>

    <section class="every wrap" aria-labelledby="every-title">
      <h2 id="every-title">{text.everyHour}</h2>
      <p>{text.everyHourNote}</p>
      <ul>
        {shared.map((section) => (
          <li><a href={`${agpeyaPath(locale, 'prime')}#${section.id}`}>{section.title[locale]}</a></li>
        ))}
      </ul>
    </section>
  </div>

  <script>
    // The hand shows the reader's time on the old Jewish reckoning (hours counted from sunrise at 6 a.m. and from sunset
    // at 6 p.m.), the caption says which hour of the day or night it is, and the nearest hour of prayer is marked "Now".
    const dial = document.querySelector<HTMLElement>('[data-dial]');
    const hand = document.querySelector<SVGGElement>('[data-hand]');
    const caption = document.querySelector<HTMLElement>('[data-now-text]');
    const hours = JSON.parse(dial?.dataset['hours'] ?? '[]') as { id: string; at: number }[];
    const words = JSON.parse(dial?.dataset['words'] ?? '{}') as { ordinals?: string[]; day?: string; night?: string };
    const show = (): void => {
      const clock = new Date();
      const now = clock.getHours() + clock.getMinutes() / 60;
      const sinceSunrise = (((now - 6) % 24) + 24) % 24;
      // Noon (the sixth hour) is at the top, so the hand turns from there.
      hand?.setAttribute('transform', `rotate(${((sinceSunrise - 6) / 24) * 360} 150 150)`);
      const night = sinceSunrise >= 12;
      const ordinal = words.ordinals?.[Math.floor(sinceSunrise % 12)] ?? '';
      if (caption !== null) caption.textContent = (night ? words.night : words.day)?.replace('{n}', ordinal) ?? '';
      // Midnight is 24 and also 0.
      let best: { id: string; gap: number } | undefined;
      for (const hour of hours) {
        const raw = Math.abs(now - hour.at);
        const gap = Math.min(raw, 24 - raw);
        if (best === undefined || gap < best.gap) best = { id: hour.id, gap };
      }
      for (const el of document.querySelectorAll('[data-hour-card] .now')) el.setAttribute('hidden', '');
      for (const el of document.querySelectorAll('.hr.is-now, .mark.is-now')) el.classList.remove('is-now');
      if (best !== undefined) {
        document.querySelector(`[data-hour-card="${best.id}"] .now`)?.removeAttribute('hidden');
        document.querySelector(`[data-hour-card="${best.id}"] .hr`)?.classList.add('is-now');
        document.querySelector(`[data-mark="${best.id}"]`)?.classList.add('is-now');
      }
    };
    show();
    setInterval(show, 30_000);
  </script>
</Base>

<style>
  .intro {
    display: grid;
    gap: 1rem 3rem;
    align-items: center;
    padding-block: clamp(1.75rem, 4.5vw, 3rem) 1rem;
  }

  @media (min-width: 52rem) {
    .intro {
      grid-template-columns: minmax(0, 1fr) minmax(0, 17rem);
    }
  }

  h1 {
    font-size: var(--step-hero);
    margin-block-end: 0.3rem;
  }

  .sub {
    margin: 0;
    color: var(--ink-muted);
    font-family: var(--font-reading);
    font-size: var(--step-2);
  }

  /* The dial is drawn in thin lines, like the site's icons. */
  .dial {
    margin: 0;
    justify-self: center;
    inline-size: min(100%, 17rem);
  }

  .dial svg {
    display: block;
    inline-size: 100%;
    block-size: auto;
    overflow: visible;
  }

  .face {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.4;
  }

  /* The night is the lower half, faintly shaded; the horizon divides it from the day. */
  .night {
    fill: var(--ink);
    opacity: 0.06;
  }

  .horizon {
    stroke: var(--ink-muted);
    stroke-width: 1;
    stroke-dasharray: 3 4;
  }

  .num {
    fill: var(--ink);
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 600;
  }

  .night-num {
    fill: var(--ink-muted);
  }

  .dial figcaption {
    display: grid;
    gap: 0.2rem;
    margin-block-start: 0.6rem;
    text-align: center;
  }

  .now-text {
    font-weight: 600;
    color: var(--burgundy);
  }

  .now-text:empty {
    display: none;
  }

  .dial-note {
    color: var(--ink-muted);
    font-size: var(--step--1);
  }

  .tick {
    stroke: var(--ink-muted);
    stroke-width: 1;
    stroke-linecap: round;
  }

  .tick.big {
    stroke: var(--ink);
    stroke-width: 1.6;
  }

  .hand-line {
    stroke: var(--accent);
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  .hand-dot,
  .hub {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  /* The hours of prayer are small crosses; the current one is drawn heavier, in burgundy. */
  .mark {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.3;
    stroke-linejoin: miter;
    transition: stroke 0.3s, stroke-width 0.3s, fill 0.3s;
  }

  .mark.is-now {
    fill: var(--burgundy);
    stroke: var(--burgundy);
    stroke-width: 1.6;
  }

  .hub {
    stroke-linejoin: miter;
  }

  .hours,
  .every {
    padding-block: 1rem 2rem;
  }

  .hours h2,
  .every h2 {
    font-size: var(--step-2);
  }

  /* The hours: an outline and nothing else; the line darkens on hover. */
  .hr-list {
    display: grid;
    gap: 0.9rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hr {
    position: relative;
    display: grid;
    gap: 0.25rem;
    align-content: start;
    block-size: 100%;
    padding: 1rem 1.1rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: transparent;
    color: var(--ink);
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s;
  }

  .hr:hover,
  .hr:focus-visible {
    border-color: var(--ink);
    background: var(--tint);
  }

  .hr.is-now {
    border-color: var(--burgundy);
  }

  .now {
    position: absolute;
    inset-block-start: 0.85rem;
    inset-inline-end: 0.9rem;
    padding: 0 0.55rem;
    border: 1px solid var(--burgundy);
    border-radius: 999px;
    color: var(--burgundy);
    font-size: 0.7rem;
    font-weight: 600;
  }

  .hr-time {
    color: var(--ink-muted);
    font-size: 0.78rem;
    padding-inline-end: 3rem;
  }

  .hr-title {
    font-family: var(--font-reading);
    font-size: var(--step-2);
    font-weight: 600;
    line-height: 1.2;
  }

  .hr-other {
    color: var(--ink-muted);
    font-family: var(--font-reading);
  }

  .every p {
    max-inline-size: 48em;
    color: var(--ink-muted);
  }

  .every ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.6rem 0 1rem;
    padding: 0;
    list-style: none;
  }

  .every li a {
    display: inline-block;
    padding: 0.25rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font-size: 0.88rem;
    text-decoration: none;
  }

  .every li a:hover {
    border-color: var(--accent);
    background: var(--tint);
  }

</style>
