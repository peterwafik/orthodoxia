---
import Apo from '../../../../layouts/Apo.astro';
import { LOCALES, type Locale } from '../../../../i18n/index.ts';
import { JOURNEYS, apoPath } from '../../../../lib/apologetics/index.ts';
import { ui } from '../../../../lib/apologetics/ui.ts';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}
const locale = Astro.params.lang as Locale;
const text = ui(locale);
---

<Apo locale={locale} title={text.journeysTitle} description={text.journeysIntro}>
  <div class="wrap">
    <h1>{text.journeysTitle}</h1>
    <p class="lede">{text.journeysIntro}</p>
    <ul class="apo-grid">
      {JOURNEYS.map((j) => (
        <li><a class="apo-card" href={apoPath(locale, `journeys/${j.slug}`)}><h3>{j.title[locale]}</h3><p>{j.summary[locale]}</p><span class="more">{text.openJourney}</span></a></li>
      ))}
    </ul>
  </div>
</Apo>
