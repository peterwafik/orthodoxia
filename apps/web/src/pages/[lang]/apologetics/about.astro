---
import Apo from '../../../layouts/Apo.astro';
import { LOCALES, type Locale } from '../../../i18n/index.ts';
import { ABOUT } from '../../../data/apologetics/pages.ts';
import { ui } from '../../../lib/apologetics/ui.ts';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}
const locale = Astro.params.lang as Locale;
const text = ui(locale);
---

<Apo locale={locale} title={text.nav_about} description={text.perspective}>
  <article class="wrap prose">
    <h1>{text.nav_about}</h1>
    <p class="lede">{text.perspective}</p>
    {ABOUT.map((b) => <section id={b.id}><h2>{b.heading[locale]}</h2>{b.body[locale].map((p) => <p>{p}</p>)}</section>)}
  </article>
</Apo>
