---
import Apo from '../../../../layouts/Apo.astro';
import SourceCard from '../../../../components/apologetics/SourceCard.astro';
import { LOCALES, type Locale } from '../../../../i18n/index.ts';
import {
  ARTICLE_BY_QUESTION,
  GLOSSARY_TERMS,
  QUESTIONS,
  QUESTION_BY_ID,
  SOURCE_BY_ID,
  TOPIC_BY_ID,
  apoPath,
  bibleLink,
  showsDraftNotice,
} from '../../../../lib/apologetics/index.ts';
import { ARGUMENT_TYPE, DIFFICULTY, STATE } from '../../../../lib/apologetics/labels.ts';
import { passageVerses } from '../../../../lib/apologetics/passages.ts';
import { CORRECTIONS_URL, fill, ui } from '../../../../lib/apologetics/ui.ts';
import { inLocale } from '../../../../lib/apologetics/arabic.ts';

export function getStaticPaths() {
  return LOCALES.flatMap((lang) => QUESTIONS.map((q) => ({ params: { lang, slug: q.slug } })));
}

const locale = Astro.params.lang as Locale;
const text = ui(locale);
const question = QUESTIONS.find((q) => q.slug === Astro.params.slug)!;
const topic = TOPIC_BY_ID.get(question.topic)!;
const article = ARTICLE_BY_QUESTION.get(question.id);
const isDraft = article !== undefined && showsDraftNotice(article);
/** An evidence item by its number in the list ("[3]"), the same in both languages; its id stays in the link. */
const evidenceNumber = (id: string): string =>
  `[${String((article?.evidence.findIndex((e) => e.id === id) ?? -1) + 1)}]`;
const paragraphs = (p: { en: readonly string[]; ar: readonly string[] }): readonly string[] => p[locale];
const terms = article === undefined ? [] : GLOSSARY_TERMS.filter((g) => article.glossary.includes(g.id));
const passages =
  article === undefined
    ? []
    : article.evidence.flatMap((e) => {
        if (e.bible === undefined) return [];
        const verses = passageVerses(e.bible);
        const link = bibleLink(locale, e.bible);
        return verses === null || link === null ? [] : [{ id: e.id, link, verses }];
      });
const citation = article === undefined ? '' : `Orthodoxia, “${question.title[locale]}”, ${text.section}, ${fill(text.updated, { n: article.revision })} ${article.updated}.`;
// One path through the answer, in reading order (empty parts are left out).
const toc = [
  ['answer', text.answerHeading],
  ['why', text.whyHeading],
  ['evidence', text.evidenceSection],
  ['teaching', text.teachingHeading],
  ['objections', text.objectionsHeading],
  ['conclusion', text.conclusion],
  ['sources', text.sourcesHeading],
  ['related', text.related],
] as const;
const visibleToc = toc.filter(([id]) => {
  if (article === undefined) return false;
  if (id === 'objections') return article.objections.length > 0;
  if (id === 'related') return article.related.length > 0;
  return true;
});
---

<Apo locale={locale} title={question.title[locale]} description={article?.shortAnswer[locale] ?? text.noAnswerBody} noindex={article === undefined}>
  <div class="apo-progress" aria-hidden="true"><div id="apo-bar"></div></div>
  <div class="wrap" id="apo-root" data-qid={question.id}>
    <p class="apo-crumbs">
      <a href={apoPath(locale)}>{text.section}</a> / <a href={apoPath(locale, `topics/${topic.slug}`)}>{topic.title[locale]}</a>
    </p>
    <h1>{question.title[locale]}</h1>
    <div class="badges">
      <span class="badge">{DIFFICULTY[question.difficulty][locale]}</span>
      {question.argumentTypes.map((a) => <span class="badge badge--burgundy">{ARGUMENT_TYPE[a][locale]}</span>)}
      <span class={`badge ${article === undefined ? '' : isDraft ? 'badge--draft' : 'badge--ok'}`}>{article === undefined ? STATE.backlog[locale] : isDraft ? STATE[article.state][locale] : text.answered}</span>
    </div>

    {
      article === undefined ? (
        <>
          <div class="apo-empty" role="note">
            <h2 style="margin-block-start:0">{text.noAnswerTitle}</h2>
            <p>{text.noAnswerBody}</p>
          </div>
          <h2>{text.noAnswerLeads}</h2>
          {
            question.leads.length === 0 ? (
              <p>{text.noAnswerNone}</p>
            ) : (
              <ul class="apo-sources">
                {question.leads.map((id) => <li><SourceCard source={SOURCE_BY_ID.get(id)!} locale={locale} /></li>)}
              </ul>
            )
          }
          <div class="apo-actions">
            <button type="button" class="apo-btn" data-report data-kind="request" data-title={question.title[locale]}>{text.requestAnswer}</button>
            <button type="button" class="apo-btn" data-save data-aria-saved={text.saved} aria-pressed="false">{text.save}</button>
          </div>
          <p class="apo-hint" data-report-note hidden>{text.reportNote}</p>
        </>
      ) : (
        <div id="apo-view">
          {isDraft && <div class="apo-banner" role="note"><p>{text.draftBanner}</p></div>}
          <p class="apo-meta">
            <span>{fill(text.updated, { n: article.revision })} <time datetime={article.updated}>{article.updated}</time></span>
          </p>
          <div class="apo-actions">
            <button type="button" class="apo-btn" data-save data-aria-saved={text.saved} aria-pressed="false">{text.save}</button>
            <button type="button" class="apo-btn" data-cite data-text={citation} data-done={text.copied}>{text.cite}</button>
          </div>

          <div class="apo-layout">
            <nav class="apo-toc" aria-label={text.onThisPage}>
              <strong>{text.onThisPage}</strong>
              <ol>
                {visibleToc.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}
              </ol>
            </nav>

            <div class="apo-article">
              {/* 1. The answer first. */}
              <section id="answer">
                <h2>{text.answerHeading}</h2>
                <p class="apo-short">{article.shortAnswer[locale]}</p>
                <ul>{article.quickPoints[locale].map((point) => <li>{point}</li>)}</ul>
              </section>

              {/* 2. Why the question matters, with the background a reader needs. */}
              <section id="why">
                <h2>{text.whyHeading}</h2>
                {paragraphs(article.whyExamine).map((p) => <p>{p}</p>)}
                {paragraphs(article.background).map((p) => <p>{p}</p>)}
                {
                  terms.length > 0 && (
                    <>
                      <h3>{text.glossaryTerms}</h3>
                      <ul class="apo-list">
                        {terms.map((g) => <li><a href={`${apoPath(locale, 'glossary')}#${g.id}`}>{g.term[locale]}</a>: {g.definition[locale]}</li>)}
                      </ul>
                    </>
                  )
                }
              </section>

              {/* 3. The evidence: each point with its reasoning and sources, the historical case, then the Scripture itself. */}
              <section id="evidence">
                <h2>{text.evidenceSection}</h2>
                {
                  article.claims.map((c) => (
                    <div class="apo-claim" id={c.id}>
                      <h3>{c.proposition[locale]}</h3>
                      <p>
                        {c.rationale[locale]}
                        {' '}
                        <span class="muted">{c.evidence.map((id, i) => <>{i > 0 ? ' ' : ''}<a href={`#ev-${id}`} title={id}>{evidenceNumber(id)}</a></>)}</span>
                      </p>
                    </div>
                  ))
                }
                {paragraphs(article.christianResponse.historical).map((p) => <p>{p}</p>)}
                {
                  passages.length > 0 && (
                    <div id="passages">
                      <h3>{text.inScripture}</h3>
                      {
                        passages.map((p) => (
                          <div>
                            <h4><a href={p.link.href}><bdi>{p.link.label}</bdi></a></h4>
                            {/* The page's own language only: King James on English pages, Van Dyck on Arabic ones. */}
                            <div class="apo-passage" lang={locale} dir={locale === 'ar' ? 'rtl' : 'ltr'}>
                              <p class="muted"><small>{locale === 'ar' ? 'ترجمة فان دايك' : 'King James Version'}</small></p>
                              {p.verses[locale].map((v) => <p><sup>{v.n}</sup> {v.text}</p>)}
                            </div>
                          </div>
                        ))
                      }
                    </div>
                  )
                }
              </section>

              {/* 4. What the Church teaches, and how the Coptic Orthodox Church lives it. */}
              <section id="teaching">
                <h2>{text.teachingHeading}</h2>
                {paragraphs(article.christianResponse.theological).map((p) => <p>{p}</p>)}
                {article.coptic !== null && paragraphs(article.coptic).map((p) => <p>{p}</p>)}
              </section>

              {/* 5. The usual objections, each answered. */}
              {
                article.objections.length > 0 && (
                  <section id="objections">
                    <h2>{text.objectionsHeading}</h2>
                    {
                      article.objections.map((o) => (
                        <details class="apo-objection" id={o.id}>
                          <summary>{o.statement[locale]}</summary>
                          <div>
                            {paragraphs(o.response).map((p) => <p>{p}</p>)}
                            {
                              o.evidence !== undefined && o.evidence.length > 0 && (
                                <p class="muted">{o.evidence.map((id, i) => <>{i > 0 ? ' ' : ''}<a href={`#ev-${id}`} title={id}>{evidenceNumber(id)}</a></>)}</p>
                              )
                            }
                          </div>
                        </details>
                      ))
                    }
                  </section>
                )
              }

              {/* 6. The conclusion the page leads to. */}
              <section id="conclusion">
                <h2>{text.conclusion}</h2>
                <p class="apo-short">{article.conclusion[locale]}</p>
              </section>

              {/* The sources behind the numbers [1], [2]… and a way to report a mistake. */}
              <section id="sources">
                <h2>{text.sourcesHeading}</h2>
                <ol class="apo-links">
                  {
                    article.evidence.map((e) => {
                      const source = SOURCE_BY_ID.get(e.sourceId)!;
                      const link = e.bible === undefined ? null : bibleLink(locale, e.bible);
                      const whole = e.locator.toLowerCase().startsWith('whole work');
                      const href = link !== null ? link.href : source.url;
                      const external = link === null && source.url.startsWith('http');
                      return (
                        <li id={`ev-${e.id}`}>
                          <a href={href} {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                            <bdi>{link !== null ? link.label : source.title}</bdi>
                          </a>
                          <span class="muted">
                            {link === null && <> · <bdi>{source.author}</bdi></>}
                            {link === null && !whole && <> · <bdi>{inLocale(e.locator, locale)}</bdi></>}
                          </span>
                        </li>
                      );
                    })
                  }
                </ol>
                {
                  article.corrections.length > 0 && (
                    <>
                      <h3>{text.correctionHistory}</h3>
                      <ul class="apo-list">{article.corrections.map((c) => <li><time datetime={c.date}>{c.date}</time>: {c.note[locale]}</li>)}</ul>
                    </>
                  )
                }
                <div class="apo-actions">
                  {
                    CORRECTIONS_URL === '' ? (
                      <>
                        <button type="button" class="apo-btn" data-report data-kind="correction" data-title={question.title[locale]} data-rev={String(article.revision)}>{text.reportCopy}</button>
                        <p class="apo-hint" data-report-note hidden>{text.reportNote}</p>
                      </>
                    ) : (
                      <a class="apo-btn" href={CORRECTIONS_URL}>{text.reportCorrection}</a>
                    )
                  }
                </div>
              </section>

              {
                article.related.length > 0 && (
                  <section id="related">
                    <h2>{text.related}</h2>
                    <ul class="apo-list">
                      {
                        article.related.map((id) => {
                          const q = QUESTION_BY_ID.get(id)!;
                          return <li><a href={apoPath(locale, `questions/${q.slug}`)}>{q.title[locale]}</a></li>;
                        })
                      }
                    </ul>
                  </section>
                )
              }
            </div>
          </div>
        </div>
      )
    }
  </div>
</Apo>

<script>
  const root = document.getElementById('apo-root');
  const view = document.getElementById('apo-view');
  const SAVED_KEY = 'orthodoxia:apo-saved';

  function readList(): string[] {
    try {
      const raw = localStorage.getItem(SAVED_KEY);
      const parsed: unknown = raw === null ? [] : JSON.parse(raw);
      return Array.isArray(parsed) ? parsed.filter((x): x is string => typeof x === 'string') : [];
    } catch {
      return [];
    }
  }

  // Reading progress and the current section in the table of contents.
  const bar = document.getElementById('apo-bar');
  if (bar !== null && view !== null) {
    const update = (): void => {
      const rect = view.getBoundingClientRect();
      const total = rect.height - window.innerHeight;
      const done = total <= 0 ? 1 : Math.min(1, Math.max(0, -rect.top / total));
      bar.style.transform = `scaleX(${done})`;
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.apo-toc a')];
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              for (const a of links) a.toggleAttribute('aria-current', a.getAttribute('href') === `#${entry.target.id}`);
            }
          }
        },
        { rootMargin: '0px 0px -70% 0px' },
      );
      for (const section of document.querySelectorAll('.apo-article section')) observer.observe(section);
    }
  }

  // Save for later: a list on this device only.
  const save = document.querySelector<HTMLButtonElement>('[data-save]');
  const qid = root?.dataset['qid'];
  if (save !== null && qid !== undefined) {
    const label = save.textContent ?? '';
    const savedLabel = save.dataset['ariaSaved'] ?? label;
    const paint = (): void => {
      const on = readList().includes(qid);
      save.setAttribute('aria-pressed', String(on));
      save.textContent = on ? savedLabel : label;
    };
    paint();
    save.addEventListener('click', () => {
      const list = readList();
      const next = list.includes(qid) ? list.filter((x) => x !== qid) : [...list, qid];
      try {
        localStorage.setItem(SAVED_KEY, JSON.stringify(next));
      } catch {
        // Storage unavailable.
      }
      paint();
    });
  }

  // Copy a citation.
  const cite = document.querySelector<HTMLButtonElement>('[data-cite]');
  cite?.addEventListener('click', () => {
    const value = `${cite.dataset['text'] ?? ''} ${location.origin}${location.pathname}`;
    const label = cite.textContent;
    void navigator.clipboard?.writeText(value).then(() => {
      cite.textContent = cite.dataset['done'] ?? label;
      window.setTimeout(() => {
        cite.textContent = label;
      }, 1800);
    });
  });

  // No inbox is configured, so a correction report is copied for the reader to pass on. Nothing is sent.
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-report]')) {
    button.addEventListener('click', () => {
      const kind = button.dataset['kind'] === 'request' ? 'Answer requested' : 'Correction';
      const rev = button.dataset['rev'] === undefined ? '' : ` (revision ${button.dataset['rev']})`;
      const value = `${kind}: ${button.dataset['title'] ?? ''}${rev}\n${location.origin}${location.pathname}\n\nWhat is wrong or missing:\n`;
      void navigator.clipboard?.writeText(value);
      const note = button.parentElement?.querySelector<HTMLElement>('[data-report-note]') ?? button.parentElement?.parentElement?.querySelector<HTMLElement>('[data-report-note]');
      if (note) note.hidden = false;
    });
  }
</script>
