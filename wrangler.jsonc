// Cloudflare Workers static assets: no Worker script, so every request is a free static-asset
// request (docs/phase-0/05-hosting-evaluation.md). Deployed by .github/workflows/ci.yml.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "orthodoxia",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
